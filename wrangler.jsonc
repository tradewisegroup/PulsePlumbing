{
	"compatibility_date": "2026-04-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "pulse-plumbing-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Static 404.html was swallowing POST /api/* (empty 405) so the
		// Worker never ran. Quote forms then showed a generic error.
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	// Call tracking stays off until a provider script URL is set in the
	// Cloudflare Pages environment (Production + Preview) and this flag
	// is flipped to "true". CALL_WEBHOOK_SECRET is a Pages secret, not a var.
	"vars": {
		"PUBLIC_CALL_TRACKING_ENABLED": "false",
		"PUBLIC_CALL_TRACKING_SCRIPT": ""
	},
	// Create in the Cloudflare account that owns pulse-plumbing Pages:
	//   npx wrangler d1 create pulse-leads
	// then replace database_id with the printed UUID and
	//   npx wrangler d1 migrations apply pulse-leads --remote
	// Local/dev uses the same name via --local (no remote id required).
	// API routes read the binding as env.DB from 'cloudflare:workers'
	// (Astro 6 removed Astro.locals.runtime.env).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pulse-leads",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations"
		}
	]
}