# Pulse Plumbing & Gas — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git

# ── Resend (required — primary lead delivery path) ────
# Sign up at resend.com → add pulseqld.com.au domain → copy API key.
# Without this key ALL form submissions return 502 and show the error state.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Lead notification recipients ──────────────────────
# LEAD_NOTIFY_TO is used by /api/contact and /api/civil-contact.
# JOBS_NOTIFY_TO is used by /api/job-application.
# Both have sensible defaults; override here only if routing changes.
LEAD_NOTIFY_TO=admin@pulseqld.com.au
JOBS_NOTIFY_TO=accounts@pulseqld.com.au

# ── Google ────────────────────────────────────────────
GTM_ID=GTM-XXXXXXX
GA4_ID=G-XXXXXXXXXX

# ── Site ─────────────────────────────────────────────
PUBLIC_SITE_URL=https://pulseqld.com.au
PUBLIC_PHONE=0452188420
