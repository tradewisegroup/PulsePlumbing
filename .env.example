# Pulse Plumbing & Gas — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git

# ── Resend (required — primary lead delivery path) ────
# Sign up at resend.com → add pulseqld.com.au domain → copy API key.
# Without this key ALL form submissions return 502 and show the error state.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Required at Cloudflare runtime (Pages → Settings → Environment variables).
# Vite cannot bake this in — the Worker reads it from cloudflare:workers env.
# Optional. Override only for local verification against a mock inbox.
# Leave unset in production — defaults to https://api.resend.com/emails
# RESEND_API_URL=https://api.resend.com/emails

# ── Lead notification recipients ──────────────────────
# LEAD_NOTIFY_TO is used by /api/contact and /api/civil-contact.
# JOBS_NOTIFY_TO is used by /api/job-application.
# Both have sensible defaults; override here only if routing changes.
LEAD_NOTIFY_TO=admin@pulseqld.com.au
JOBS_NOTIFY_TO=accounts@pulseqld.com.au

# ── Google ────────────────────────────────────────────
# PUBLIC_ prefix required — Astro only exposes PUBLIC_* vars in the browser bundle.
# These are baked in at BUILD TIME on Cloudflare Pages.
# To activate: set them in Cloudflare Pages → Settings → Environment variables
# (under both Production and Preview), then trigger a new deploy.
# Without PUBLIC_GTM_ID the GTM snippet is omitted entirely from the HTML output.
PUBLIC_GTM_ID=GTM-MMNMHPTK
PUBLIC_GA4_ID=G-0NV48PLVLP

# ── Site ─────────────────────────────────────────────
PUBLIC_SITE_URL=https://pulseqld.com.au
PUBLIC_PHONE=0452188420
