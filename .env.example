# Pulse Plumbing & Gas — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git

# ── AroFlo Direct API ────────────────────────────
# AroFlo uses HMAC-SHA512 auth. Generate these in AroFlo:
#   Site Administration > Settings > General > AroFlo API
# Copy ALL FOUR values shown (uEncoded, pEncoded, orgEncoded, API Secret Key)
# BEFORE clicking Save — the secret key is shown only once.
AROFLO_BASE_URL=https://api.aroflo.com
AROFLO_UENCODED=your_uEncoded_value
AROFLO_PENCODED=your_pEncoded_API_Key_value
AROFLO_ORGENCODED=your_orgEncoded_value
AROFLO_SECRET_KEY=your_API_Secret_Key
# Optional: only set if you sign from a fixed public IP (leave blank in cloud/serverless).
# If set here, it MUST match the IP the request actually originates from.
AROFLO_HOSTIP=

# ── HubSpot ──────────────────────────────────────
HUBSPOT_API_BASE=https://api-ap1.hsforms.com
HUBSPOT_PORTAL_ID=your_portal_id
HUBSPOT_FORM_ID=main_quote_form_id
HUBSPOT_CIVIL_FORM_ID=civil_rfq_form_id

# ── Google ────────────────────────────────────────
GTM_ID=GTM-XXXXXXX
GA4_ID=G-XXXXXXXXXX

# ── Site ─────────────────────────────────────────
PUBLIC_SITE_URL=https://pulseqld.com.au
PUBLIC_PHONE=0452188420
