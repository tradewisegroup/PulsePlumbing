# Pulse Plumbing & Gas — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git

# ── AroFlo Direct API ────────────────────────────
AROFLO_BASE_URL=https://api.aroflo.com
AROFLO_USERNAME=your_aroflo_api_username
AROFLO_PASSWORD=your_aroflo_api_password
AROFLO_SECRET_KEY=your_aroflo_secret_key

# ── HubSpot ──────────────────────────────────────
HUBSPOT_PORTAL_ID=your_portal_id
HUBSPOT_FORM_ID=main_quote_form_id
HUBSPOT_CIVIL_FORM_ID=civil_rfq_form_id
HUBSPOT_EMERGENCY_FORM_ID=emergency_form_id

# ── Google ────────────────────────────────────────
GTM_ID=GTM-XXXXXXX
GA4_ID=G-XXXXXXXXXX

# ── Site ─────────────────────────────────────────
PUBLIC_SITE_URL=https://pulseqld.com.au
PUBLIC_PHONE=0452188420
