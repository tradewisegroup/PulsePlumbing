---
import BaseLayout from './BaseLayout.astro';
import QuoteForm from '../components/forms/QuoteForm.jsx';

// ─── Props ────────────────────────────────────────────────────────────────────

export interface Props {
  /** Display name, e.g. "Blocked Drains" */
  serviceName: string;
  /** URL slug, e.g. "blocked-drains" → /services/blocked-drains */
  serviceSlug: string;
  /** H1 */
  heroTitle: string;
  /** Paragraph beneath the H1 */
  heroSubtitle: string;
  /** Exactly 4 short benefit statements for the why-us cards */
  keyBenefits: [string, string, string, string];
  /** Step-by-step service process — 3–5 steps */
  process: { title: string; description: string }[];
  /** At least 5 Q&A pairs */
  faqs: { q: string; a: string }[];
  /** Industry slugs this service is relevant to */
  relatedIndustries: string[];
  /** <head> meta title */
  metaTitle: string;
  /** <head> meta description */
  metaDescription: string;
  /** Optional hero background image path, e.g. "/images/van-hero.jpg" */
  heroImage?: string;
  /** CSS background-size value — defaults to 'cover'. Use 'contain' to show the full image. */
  heroImageFit?: string;
}

// ─── Data ─────────────────────────────────────────────────────────────────────

const {
  serviceName,
  serviceSlug,
  heroTitle,
  heroSubtitle,
  keyBenefits,
  process,
  faqs,
  relatedIndustries,
  metaTitle,
  metaDescription,
  heroImage,
  heroImageFit = 'cover',
} = Astro.props;

const SITE     = 'https://pulseqld.com.au';
const PHONE    = '0452 188 420';
const PHONE_HREF = 'tel:0452188420';

// Industry catalogue — keyed by slug
const INDUSTRY_DATA: Record<string, { label: string; icon: string }> = {
  'retail':                 { label: 'Retail',                 icon: '🛒' },
  'childcare':              { label: 'Childcare',              icon: '👶' },
  'education':              { label: 'Education',              icon: '🎓' },
  'aged-care':              { label: 'Aged Care',              icon: '❤️' },
  'student-accommodation':  { label: 'Student Accommodation',  icon: '🏘️' },
  'commercial-real-estate': { label: 'Commercial Real Estate', icon: '🏗️' },
  'property-management':    { label: 'Property Management',    icon: '🔑' },
  'new-builds':             { label: 'New Builds',             icon: '🏗️' },
  'civil':                  { label: 'Civil',                  icon: '🚧' },
};

const TRUST_ITEMS = [
  { label: 'QBCC Licensed',        icon: '✅' },
  { label: '24/7 Response',        icon: '🕐' },
  { label: '10+ Years Experience', icon: '⭐' },
  { label: 'Insurance Covered',    icon: '🛡️' },
  { label: 'Same Day Service',     icon: '⚡' },
];

const BENEFIT_ICONS = ['🔧', '⚡', '🛡️', '📋'];

const resolvedIndustries = relatedIndustries
  .map((slug) => ({ slug, ...INDUSTRY_DATA[slug] }))
  .filter((i) => i.label);

// ─── Schema ───────────────────────────────────────────────────────────────────

const serviceSchema = {
  '@type': 'Service',
  '@id': `${SITE}/services/${serviceSlug}/#service`,
  name: serviceName,
  description: heroSubtitle,
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${SITE}/#business`,
  },
  areaServed: [
    { '@type': 'City', name: 'Brisbane' },
    { '@type': 'City', name: 'Logan' },
    { '@type': 'City', name: 'Gold Coast' },
    { '@type': 'City', name: 'Ipswich' },
  ],
  url: `${SITE}/services/${serviceSlug}`,
};

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE}/services/${serviceSlug}/#faq`,
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${SITE}/services/${serviceSlug}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',     item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE}/services` },
    { '@type': 'ListItem', position: 3, name: serviceName, item: `${SITE}/services/${serviceSlug}` },
  ],
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [serviceSchema, faqSchema, breadcrumbSchema],
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={`${SITE}/services/${serviceSlug}`}
  schema={pageSchema}
>

  <!-- ══════════════════════════════════════════════════════════════════════════
       1. HERO
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-[#000000]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class={`grid gap-12 items-center${heroImage ? ' lg:grid-cols-2' : ''}`}>

        <!-- Copy -->
        <div>
          <!-- Breadcrumb -->
          <nav class="mb-6 text-xs text-white/50" aria-label="Breadcrumb">
            <ol class="flex items-center gap-2">
              <li><a href="/" class="hover:text-white/80 transition-colors">Home</a></li>
              <li aria-hidden="true" class="text-white/30">/</li>
              <li><a href="/services" class="hover:text-white/80 transition-colors">Services</a></li>
              <li aria-hidden="true" class="text-white/30">/</li>
              <li class="text-white/70">{serviceName}</li>
            </ol>
          </nav>

          <!-- Service badge -->
          <div class="inline-flex items-center gap-2 bg-[#0172ae]/20 border border-[#0172ae]/40 rounded-full px-4 py-1.5 mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0172ae]" aria-hidden="true"></span>
            <span class="text-sm font-semibold text-[#0172ae]">{serviceName}</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-bold text-white leading-[1.12] tracking-tight mb-5 inline-block bg-[#0172ae]/60 px-5 py-3 rounded-xl shadow-md">
            {heroTitle}
          </h1>
          <p class="text-lg sm:text-xl text-white/70 leading-relaxed mb-10 max-w-2xl">
            {heroSubtitle}
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="/contact"
              class="inline-flex items-center justify-center bg-[#0172ae] hover:bg-[#015d8e] text-white font-semibold text-base px-7 py-3.5 rounded-full transition-colors shadow-lg shadow-[#0172ae]/30"
            >
              Get a Quote
            </a>
            <a
              href={PHONE_HREF}
              class="inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold text-base px-7 py-3.5 rounded-full transition-colors"
            >
              <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              Call {PHONE}
            </a>
          </div>
        </div>

        <!-- Hero image (right column) -->
        {heroImage && (
          <div class="flex justify-center lg:justify-end">
            <img
              src={heroImage}
              alt={`${serviceName} — Pulse Plumbing, Gas & Civil`}
              class={`w-full max-h-[420px] rounded-xl shadow-lg ${heroImageFit === 'contain' ? 'object-contain' : 'object-cover'}`}
              loading="eager"
            />
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       2. TRUST BAR
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white border-b border-slate-200" aria-label="Trust indicators">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {TRUST_ITEMS.map((item, i) => (
          <li class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            <span class="text-base leading-none" aria-hidden="true">{item.icon}</span>
            {item.label}
            {i < TRUST_ITEMS.length - 1 && (
              <span class="hidden sm:block w-px h-4 bg-slate-200 ml-8" aria-hidden="true"></span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       3. WHY PULSE — 4 benefit cards
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-[#F0F5FA]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-[#000000] leading-tight mb-4">
          Why choose Pulse for {serviceName}?
        </h2>
        <p class="text-[#334155] text-lg">
          Fast response, licensed tradespeople and transparent pricing — on every job.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {keyBenefits.map((benefit, i) => (
          <article class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-[#0172ae]/40 transition-all group">
            <div
              class="w-11 h-11 rounded-xl bg-[#0172ae]/10 flex items-center justify-center text-xl mb-4 group-hover:bg-[#0172ae]/15 transition-colors"
              aria-hidden="true"
            >
              {BENEFIT_ICONS[i]}
            </div>
            <p class="text-sm font-semibold text-[#000000] leading-snug">{benefit}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       4. HOW IT WORKS — process steps
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-white" aria-labelledby="process-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 id="process-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-4">
          How our {serviceName.toLowerCase()} service works
        </h2>
        <p class="text-[#334155] text-lg">
          A clear, efficient process — so you always know what to expect.
        </p>
      </div>

      <ol class="relative grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {process.map((step, i) => (
          <li class="relative bg-[#F0F5FA] border border-slate-200 rounded-2xl p-6 hover:border-[#0172ae]/40 transition-colors">
            <!-- Step number -->
            <div
              class="w-9 h-9 rounded-full bg-[#0172ae] text-white text-sm font-bold flex items-center justify-center mb-4 shadow-sm shadow-[#0172ae]/30"
              aria-hidden="true"
            >
              {i + 1}
            </div>
            <h3 class="font-semibold text-[#000000] mb-2 leading-snug">{step.title}</h3>
            <p class="text-sm text-[#334155] leading-relaxed">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       5. INDUSTRIES WE SERVE
       ══════════════════════════════════════════════════════════════════════════ -->
  {resolvedIndustries.length > 0 && (
    <section class="py-20 bg-[#F0F5FA]" aria-labelledby="industries-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-10">
          <h2 id="industries-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-4">
            Industries we serve
          </h2>
          <p class="text-[#334155] text-lg">
            Our {serviceName.toLowerCase()} service is available to businesses across all major commercial sectors.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          {resolvedIndustries.map((ind) => (
            <a
              href={`/industries/${ind.slug}`}
              class="inline-flex items-center gap-2 bg-white border border-slate-200 hover:border-[#0172ae] hover:text-[#0172ae] text-slate-700 text-sm font-semibold px-4 py-2.5 rounded-full shadow-sm transition-all"
            >
              <span aria-hidden="true">{ind.icon}</span>
              {ind.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════════════════════════════════
       6. FAQ ACCORDION
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-white" aria-labelledby="faq-heading">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="faq-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-3">
        Frequently asked questions
      </h2>
      <p class="text-[#334155] mb-10 text-lg">
        Everything you need to know about our {serviceName.toLowerCase()} service.
      </p>

      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <details
            class="group border border-slate-200 rounded-2xl overflow-hidden bg-white shadow-sm hover:border-[#0172ae]/40 transition-colors open:border-[#0172ae]/40"
            {...i === 0 ? { open: true } : {}}
          >
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none select-none hover:bg-[#F0F5FA] group-open:bg-[#F0F5FA] transition-colors">
              <span class="font-semibold text-[#000000] text-sm sm:text-base leading-snug pr-4">
                {faq.q}
              </span>
              <span
                class="flex-shrink-0 w-6 h-6 rounded-full border-2 border-slate-200 group-open:border-[#0172ae] group-open:bg-[#0172ae] flex items-center justify-center transition-all"
                aria-hidden="true"
              >
                <svg class="w-3 h-3 text-slate-500 group-open:text-white group-open:rotate-45 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-5 pt-1 border-t border-slate-100 text-[#334155] text-sm leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       7. TESTIMONIAL (named slot — optional)
       ══════════════════════════════════════════════════════════════════════════ -->
  {Astro.slots.has('testimonial') && (
    <section class="py-16 bg-[#000000]" aria-label="Client testimonial">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex gap-2 mb-6" aria-label="5 star rating">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <slot name="testimonial" />
      </div>
    </section>
  )}

  <!-- ══════════════════════════════════════════════════════════════════════════
       8. CTA FORM
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-[#0172ae]" aria-labelledby="cta-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">

        <div>
          <h2 id="cta-heading" class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-4">
            Book {serviceName} in South-East QLD
          </h2>
          <p class="text-blue-100 text-lg leading-relaxed mb-6">
            Get a clear, upfront quote from a QBCC-licensed plumber — no obligations, no hidden costs.
          </p>
          <ul class="space-y-2">
            {[
              'Fast response — typically same day',
              'QBCC licensed and fully insured',
              'Transparent pricing before we start',
              'Available 24/7 for emergencies',
            ].map((point) => (
              <li class="flex items-center gap-3 text-blue-50 text-sm">
                <svg class="w-4 h-4 text-white/60 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {point}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <QuoteForm client:load />
        </div>

      </div>
    </div>
  </section>

  <!-- Default slot — extra per-page content -->
  <slot />

</BaseLayout>
