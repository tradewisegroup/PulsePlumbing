---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/seo/Head.astro';
import {
  BRAND_NAME,
  EMAIL,
  EMERGENCY_PHONE_TEL,
  LEGAL_NAME,
  OFFICE_PHONE_TEL,
  SITE_URL,
  businessIdentifiers,
  getSameAs,
} from '../lib/site';

// ─── Props ────────────────────────────────────────────────────────────────────

export interface Props {
  /** Page-level title — formatted as "{title} | Pulse Plumbing & Gas Brisbane" */
  title: string;
  /** Meta description — ideally 140–160 characters */
  description: string;
  /** Canonical URL — defaults to current page URL */
  canonical?: string;
  /** Absolute or root-relative path to OG image — defaults to /images/og-default.jpg */
  ogImage?: string;
  /** og:type — defaults to "website" */
  ogType?: 'website' | 'article';
  /** Prevent indexing (404s, thank-you pages, etc.) */
  noindex?: boolean;
  /**
   * Path to the LCP hero image (e.g. "/images/hero-homepage.png").
   * When set, emits a high-priority <link rel="preload"> so the browser
   * fetches the hero before rendering, improving LCP.
   */
  heroImage?: string;
  /**
   * Additional page-level JSON-LD schema object.
   * The LocalBusiness schema is always injected by this layout.
   * Pass a Service, Article, FAQPage, etc. here for page-specific markup.
   */
  schema?: Record<string, unknown>;
  /**
   * GTM/GA4 page context — pushed into dataLayer BEFORE the GTM snippet so
   * triggers can segment without extra GTM configuration.
   */
  pageType?: 'home' | 'service' | 'industry' | 'location' | 'civil' | 'contact' | 'about' | 'careers' | 'testimonials' | 'knowledge-base';
  /** Suburb name for location pages (e.g. "Loganholme") */
  suburb?:   string;
  /** Service slug for service pages (e.g. "blocked-drains") */
  service?:  string;
  /** Industry slug for industry pages (e.g. "childcare") */
  industry?: string;
}

// ─── Defaults ─────────────────────────────────────────────────────────────────

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  noindex = false,
  heroImage,
  schema,
  pageType  = '',
  suburb    = '',
  service   = '',
  industry  = '',
} = Astro.props;

const SITE   = SITE_URL;
// PUBLIC_ prefix required for Astro to expose the variable client-side.
// Set in Cloudflare Pages → Settings → Environment variables (Production + Preview).
// Without this var the GTM snippet is omitted entirely — no placeholder requests.
const GTM_ID = import.meta.env.PUBLIC_GTM_ID ?? '';
const HUBSPOT_PORTAL_ID = import.meta.env.HUBSPOT_PORTAL_ID ?? '';
const GSC_VERIFICATION = import.meta.env.GSC_VERIFICATION ?? '';

// Resolve ogImage to an absolute URL regardless of whether it was passed as
// a root-relative path or an already-absolute URL.
const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, SITE).href;

// ─── Always-present LocalBusiness schema ─────────────────────────────────────
// Injected on every page via this layout. Never remove.

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Plumber'],
  '@id': `${SITE}/#business`,
  name: BRAND_NAME,
  legalName: LEGAL_NAME,
  url: SITE,
  logo: `${SITE}/images/logo.png`,
  image: `${SITE}/images/og-default.jpg`,
  telephone: [EMERGENCY_PHONE_TEL, OFFICE_PHONE_TEL],
  email: EMAIL,
  description:
    'Maintenance plumbing for residential and commercial clients across Brisbane, Logan, Gold Coast and Ipswich. Available 24/7 including afterhours and weekends.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brisbane',
    addressRegion: 'QLD',
    addressCountry: 'AU',
  },
  areaServed: [
    { '@type': 'City', name: 'Brisbane' },
    { '@type': 'City', name: 'Logan' },
    { '@type': 'City', name: 'Gold Coast' },
    { '@type': 'City', name: 'Ipswich' },
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday', 'Tuesday', 'Wednesday', 'Thursday',
      'Friday', 'Saturday', 'Sunday',
    ],
    opens: '00:00',
    closes: '23:59',
  },
  priceRange: '$$',
  identifier: businessIdentifiers(),
  sameAs: getSameAs(),
};
---

<!doctype html>
<html
  lang="en-AU"
  class="scroll-smooth"
>
  <head>
    <Head
      title={`${title} | Pulse Plumbing & Gas Brisbane`}
      {description}
      {canonical}
      ogImage={ogImageAbsolute}
      {ogType}
      {noindex}
      fbProfileId="7258045949235928778"
    />

    <!-- ── LCP hero preload — emitted when heroImage prop is set ──────────── -->
    {heroImage && (
      <link
        rel="preload"
        as="image"
        href={heroImage}
        fetchpriority="high"
      />
    )}

    <!-- ── Google Tag Manager (omitted entirely when PUBLIC_GTM_ID is unset) ── -->
    {GTM_ID && (
      <>
        {/* dataLayer initialised with page context BEFORE GTM loads.
            GTM triggers can read page_type/suburb/service/industry without
            extra configuration or custom dimensions setup. */}
        <script is:inline define:vars={{ pageType, suburb, service, industry }}>
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            page_type: pageType,
            suburb:    suburb,
            service:   service,
            industry:  industry,
          });
        </script>
        <script is:inline define:vars={{ GTM_ID }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l !== 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', GTM_ID);
        </script>
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
      </>
    )}

    <!-- ── Google Search Console verification ────────────────────────── -->
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    <!-- ── JSON-LD: LocalBusiness (always present) ───────────────────── -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema, null, 0)}
    />

    <!-- ── JSON-LD: Page-specific schema (passed via props) ──────────── -->
    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema, null, 0)}
      />
    )}

    <!-- ── Page-specific head content (extra schemas, preloads, etc.) ─── -->
    <slot name="head" />

    <!-- ── HubSpot tracking (only when portal ID is configured) ──────── -->
    {HUBSPOT_PORTAL_ID && (
      <script
        is:inline
        src={`//js-ap1.hs-scripts.com/${HUBSPOT_PORTAL_ID}.js`}
        async
        defer
      />
    )}
  </head>

  <body
    class="bg-white text-slate-700 antialiased"
    style="font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;"
  >
    <!-- ── GTM noscript fallback (omitted when GTM_ID is unset) ─────── -->
    {GTM_ID && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <!-- ── Skip to content (accessibility) ──────────────────────────── -->
    <a
      href="#main-content"
      class="
        sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100]
        bg-[#0172ae] text-white font-semibold px-4 py-2 rounded
        focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#0172ae]
      "
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
