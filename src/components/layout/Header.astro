---
import MobileMenu from './MobileMenu.jsx';

const PHONE        = '07 2150 4175';
const PHONE_HREF   = 'tel:0721504175';
const AFTER_HOURS  = '0452 188 420';
const AFTER_HREF   = 'tel:0452188420';

const services = [
  { label: 'Maintenance Plumbing', href: '/services/maintenance-plumbing', desc: 'Scheduled & reactive maintenance',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>` },
  { label: 'Residential',          href: '/services/residential',          desc: 'Homes, units & townhouses',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>` },
  { label: 'Commercial',           href: '/services/commercial',           desc: 'Facilities, strata & fit-outs',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>` },
  { label: 'Gas Fitting',          href: '/services/gas-fitting',          desc: 'Lines, appliances & safety checks',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c-2 3-4 5.5-4 8a4 4 0 0 0 8 0c0-2.5-1.5-4-2-5.5 0 2-1.5 3.5-2 3.5s-2-1.5-2-3.5"/><line x1="5" y1="18" x2="19" y2="18"/><line x1="8" y1="15" x2="8" y2="18"/><line x1="12" y1="15" x2="12" y2="18"/><line x1="16" y1="15" x2="16" y2="18"/><line x1="3" y1="21" x2="21" y2="21"/></svg>` },
  { label: 'Blocked Drains',       href: '/services/blocked-drains',       desc: 'Jetting, CCTV & excavation',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="3" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="21"/><line x1="3" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="21" y2="12"/></svg>` },
  { label: 'Hot Water',            href: '/services/hot-water-systems',    desc: 'Repairs, replacements & heat pumps',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="5" width="10" height="13" rx="2"/><path d="M10 5V3M14 5V3"/><path d="M10 18v3M14 18v3"/><path d="M9.5 11.5a2.5 2.5 0 0 0 5 0"/></svg>` },
  { label: 'CCTV Drain Camera',    href: '/services/drain-camera',         desc: 'Inspection reports & root detection',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="8" width="13" height="8" rx="2"/><circle cx="7.5" cy="12" r="2.5"/><path d="M14 10.5l5.5-3.5v10L14 13.5"/></svg>` },
  { label: 'Backflow Prevention',  href: '/services/backflow-prevention',  desc: 'Testing, repairs & certification',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10h7v4H2z"/><path d="M15 10h7v4h-7z"/><path d="M9 10l6 2-6 2z"/><line x1="15" y1="10" x2="15" y2="14"/></svg>` },
  { label: 'InSinkErator',         href: '/services/insinkerator',         desc: 'Installation & repair, all models',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/></svg>` },
];

const industries = [
  { label: 'Retail',                 href: '/industries/retail'                },
  { label: 'Childcare',              href: '/industries/childcare'             },
  { label: 'Education',              href: '/industries/education'             },
  { label: 'Aged Care',              href: '/industries/aged-care'             },
  { label: 'Student Accommodation',  href: '/industries/student-accommodation' },
  { label: 'Commercial Real Estate', href: '/industries/commercial-real-estate'},
  { label: 'Property Management',    href: '/industries/property-management'   },
  { label: 'New Builds',             href: '/industries/new-builds'            },
];
---

<header class="sticky top-0 z-50 w-full">

  <!-- ── Utility bar ──────────────────────────────────────────────────── -->
  <div class="bg-[#000000] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-9 flex items-center justify-between gap-4 text-xs sm:text-sm">

      <!-- Left: availability message -->
      <div class="flex items-center gap-2 font-medium tracking-wide">
        <!-- Pulsing red availability dot -->
        <span class="relative flex h-2 w-2 flex-shrink-0" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="hidden sm:inline">Available 24/7 — Afterhours &amp; Weekends</span>
        <span class="sm:hidden">24/7 Emergency Plumber</span>
      </div>

      <!-- Right: both phone numbers -->
      <div class="flex items-center gap-4">
        <a href={PHONE_HREF} class="flex items-center gap-1.5 font-bold text-white hover:text-blue-100 transition-colors" aria-label={`Office: ${PHONE}`}>
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          <span class="hidden sm:inline text-white/60 text-xs mr-0.5">Office</span>{PHONE}
        </a>
        <a href={AFTER_HREF} class="hidden sm:flex items-center gap-1.5 font-medium text-white/70 hover:text-white transition-colors" aria-label={`After hours: ${AFTER_HOURS}`}>
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          <span class="text-white/50 text-xs mr-0.5">After hours</span>{AFTER_HOURS}
        </a>
      </div>
    </div>
  </div>

  <!-- ── Main nav bar ──────────────────────────────────────────────────── -->
  <!--
    backdrop-blur + bg-white/95 gives a frosted-glass effect on scroll.
    The blur only shows once content scrolls beneath the header.
  -->
  <div class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 lg:h-[4.5rem] gap-6">

        <!-- ── Logo ── -->
        <a
          href="/"
          class="flex-shrink-0"
          aria-label="Pulse Plumbing & Gas — Home"
        >
          <img
            src="/images/logo.png"
            alt="Pulse Plumbing & Gas"
            width="180"
            height="70"
            class="h-10 lg:h-11 w-auto"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <!-- ── Desktop navigation (centre) ── -->
        <nav
          class="hidden lg:flex items-center gap-0.5 text-sm font-semibold"
          aria-label="Main navigation"
        >

          <!-- Home -->
          <a
            href="/"
            class="px-3 py-2 text-slate-600 hover:text-[#0172ae] rounded-lg hover:bg-[#F0F5FA] transition-colors"
          >
            Home
          </a>

          <!-- Services — direct link -->
          <a href="/services" class="px-3 py-2 text-slate-600 hover:text-[#0172ae] rounded-lg hover:bg-[#F0F5FA] transition-colors">
            Services
          </a>

          <!-- Industries — direct link -->
          <a href="/industries" class="px-3 py-2 text-slate-600 hover:text-[#0172ae] rounded-lg hover:bg-[#F0F5FA] transition-colors">
            Industries
          </a>

          <!-- Civil (standalone) -->
          <a
            href="/civil"
            class="px-3 py-2 text-slate-600 hover:text-[#0172ae] rounded-lg hover:bg-[#F0F5FA] transition-colors"
          >
            Civil
          </a>

          <!-- Resources dropdown -->
          <div class="relative group">
            <button class="flex items-center gap-1 px-3 py-2 text-slate-600 hover:text-[#0172ae] rounded-lg hover:bg-[#F0F5FA] transition-colors" aria-haspopup="true">
              Resources
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#0172ae] transition-all duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="absolute top-full left-0 mt-2 w-56 bg-white border border-slate-200 rounded-2xl shadow-xl shadow-slate-200/60 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 ease-out z-50 py-2">
              <a href="/testimonials" class="flex items-start gap-3 px-4 py-3 hover:bg-[#F0F5FA] transition-colors group/item">
                <div>
                  <p class="text-sm font-semibold text-slate-800 group-hover/item:text-[#0172ae] transition-colors">Testimonials</p>
                  <p class="text-xs text-slate-400 mt-0.5">Client reviews &amp; videos</p>
                </div>
              </a>
              <a href="/knowledge-base" class="flex items-start gap-3 px-4 py-3 hover:bg-[#F0F5FA] transition-colors group/item">
                <div>
                  <p class="text-sm font-semibold text-slate-800 group-hover/item:text-[#0172ae] transition-colors">Knowledge Base</p>
                  <p class="text-xs text-slate-400 mt-0.5">Guides, costs &amp; compliance</p>
                </div>
              </a>
              <a href="/strata-scorecard" class="flex items-start gap-3 px-4 py-3 hover:bg-[#F0F5FA] transition-colors group/item">
                <div>
                  <p class="text-sm font-semibold text-slate-800 group-hover/item:text-[#0172ae] transition-colors">Compliance Scorecard</p>
                  <p class="text-xs text-slate-400 mt-0.5">Free 2-min property check</p>
                </div>
              </a>
              <a href="/blog" class="flex items-start gap-3 px-4 py-3 hover:bg-[#F0F5FA] transition-colors group/item">
                <div>
                  <p class="text-sm font-semibold text-slate-800 group-hover/item:text-[#0172ae] transition-colors">Blog</p>
                  <p class="text-xs text-slate-400 mt-0.5">News &amp; industry updates</p>
                </div>
              </a>
            </div>
          </div>

          <!-- About -->
          <a href="/about" class="px-3 py-2 text-slate-600 hover:text-[#0172ae] rounded-lg hover:bg-[#F0F5FA] transition-colors">About</a>

          <!-- Careers -->
          <a href="/careers" class="px-3 py-2 text-slate-600 hover:text-[#0172ae] rounded-lg hover:bg-[#F0F5FA] transition-colors">Careers</a>

          <!-- Contact -->
          <a href="/contact" class="px-3 py-2 text-slate-600 hover:text-[#0172ae] rounded-lg hover:bg-[#F0F5FA] transition-colors">Contact</a>

        </nav>

        <!-- ── Right: CTA + mobile controls ── -->
        <div class="flex items-center gap-3 flex-shrink-0">

          <!-- "Get a Quote" — desktop -->
          <a
            href="/contact"
            class="
              hidden lg:inline-flex items-center justify-center
              bg-[#0172ae] hover:bg-[#015d8e]
              text-white text-sm font-semibold
              rounded-full px-6 py-2
              transition-colors shadow-sm shadow-[#0172ae]/30 hover:shadow-[#0172ae]/40
            "
          >
            Get a Quote
          </a>

          <!-- Emergency phone — always visible on mobile -->
          <a
            href={AFTER_HREF}
            class="
              lg:hidden flex items-center gap-1.5
              bg-[#f19329] hover:bg-[#d97d1a]
              text-white text-xs font-bold
              rounded-full px-3 py-2
              transition-colors
            "
            aria-label={`After hours — call ${AFTER_HOURS}`}
          >
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <span>Emergency</span>
          </a>

          <!-- Hamburger / close — React island handles its own toggle state -->
          <MobileMenu client:load />

        </div>
      </div>
    </div>
  </div>

</header>
