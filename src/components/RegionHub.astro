---
import BaseLayout from '../layouts/BaseLayout.astro';
import { suburbsByRegion, type RegionKey } from '../data/locations';

export interface Props {
  areaName: string;
  regionKeys: RegionKey[];
  slug: string;
}

const { areaName, regionKeys, slug } = Astro.props;
const SITE = 'https://pulseqld.com.au';
const groups = suburbsByRegion.filter((g) => regionKeys.includes(g.key));
const allSuburbs = groups.flatMap((g) => g.suburbs);
const count = allSuburbs.length;
const title = `Plumber ${areaName}`;
const description = `QBCC-licensed plumber servicing ${areaName} and ${count} surrounding suburbs. 24/7 emergency and maintenance plumbing. Call 07 2150 4175.`;
const canonical = `${SITE}/plumber-${slug}`;
---

<BaseLayout {title} {description} {canonical} pageType="location">
  <section class="bg-[#000000] py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 text-xs text-white/60" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-white">Home</a></li>
          <li>/</li>
          <li><a href="/service-areas" class="hover:text-white">Service Areas</a></li>
          <li>/</li>
          <li class="text-white">Plumber {areaName}</li>
        </ol>
      </nav>
      <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight mb-4">
        Plumber {areaName}
      </h1>
      <p class="text-lg text-white/80 max-w-2xl">
        Pulse Plumbing &amp; Gas covers {count} suburbs across {areaName}. Same-day and 24/7 emergency response from our Ormeau base.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {groups.map((region) => (
        <div>
          <h2 class="text-2xl font-bold text-[#000000] mb-5">{region.label}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
            {region.suburbs.map((s) => (
              <a
                href={`/plumber-${s.slug}`}
                class="bg-[#F0F5FA] hover:bg-[#0172ae] border border-[#D1D5DB] hover:border-[#0172ae] rounded-lg px-3 py-2.5 transition-colors group"
              >
                <span class="block text-sm font-medium text-[#000000] group-hover:text-white">{s.name}</span>
                <span class="block text-xs text-[#334155] group-hover:text-blue-100">{s.postcode}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
