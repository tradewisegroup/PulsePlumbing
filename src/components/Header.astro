---
import { suburbsByRegion } from '../data/locations';

const PHONE = '0452 188 420';
const PHONE_HREF = 'tel:0452188420';
const PHONE_OFFICE = '07 2150 4175';
const PHONE_OFFICE_HREF = 'tel:0721504175';

// Top 5 suburbs per region for the nav mega-dropdown
const locationGroups = suburbsByRegion.map((r) => ({
  label: r.label,
  key: r.key,
  suburbs: r.suburbs.slice(0, 5),
}));

const services = [
  {
    label: 'Maintenance Plumbing',
    desc: 'Scheduled & reactive maintenance',
    href: '/services/preventative-maintenance',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  },
  {
    label: 'Commercial',
    desc: 'Facilities, strata & fit-outs',
    href: '/industries',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9.5" y1="14.5" x2="14.5" y2="14.5"/></svg>`,
  },
  {
    label: 'Residential',
    desc: 'Homes, units & townhouses',
    href: '/services/residential',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    label: 'Gas Fitting',
    desc: 'Lines, appliances & safety checks',
    href: '/services/gas-fitting',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c-2 3-4 5.5-4 8a4 4 0 0 0 8 0c0-2.5-1.5-4-2-5.5 0 2-1.5 3.5-2 3.5s-2-1.5-2-3.5"/><line x1="5" y1="18" x2="19" y2="18"/><line x1="8" y1="15" x2="8" y2="18"/><line x1="12" y1="15" x2="12" y2="18"/><line x1="16" y1="15" x2="16" y2="18"/><line x1="3" y1="21" x2="21" y2="21"/></svg>`,
  },
  {
    label: 'Blocked Drains',
    desc: 'Jetting, CCTV & excavation',
    href: '/services/blocked-drains',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="3" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="21"/><line x1="3" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="21" y2="12"/><line x1="10.5" y1="10.5" x2="13.5" y2="13.5"/><line x1="13.5" y1="10.5" x2="10.5" y2="13.5"/></svg>`,
  },
  {
    label: 'Hot Water',
    desc: 'Repairs, replacements & heat pumps',
    href: '/services/hot-water-systems',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="5" width="10" height="13" rx="2"/><path d="M10 5V3M14 5V3"/><path d="M10 18v3M14 18v3"/><path d="M9.5 11.5a2.5 2.5 0 0 0 5 0"/><line x1="12" y1="9" x2="12" y2="11.5"/></svg>`,
  },
  {
    label: 'CCTV Drain Camera',
    desc: 'Inspection reports & root detection',
    href: '/services/drain-camera',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="8" width="13" height="8" rx="2"/><circle cx="7.5" cy="12" r="2.5"/><path d="M14 10.5l5.5-3.5v10L14 13.5"/><circle cx="4.5" cy="12" r="0.5" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    label: 'Backflow Prevention',
    desc: 'Testing, repairs & certification',
    href: '/services/backflow-prevention',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10h7v4H2z"/><path d="M15 10h7v4h-7z"/><path d="M9 10l6 2-6 2z"/><line x1="15" y1="10" x2="15" y2="14"/></svg>`,
  },
];

const industries = [
  { label: 'Retail', href: '/industries/retail' },
  { label: 'Childcare', href: '/industries/childcare' },
  { label: 'Education', href: '/industries/education' },
  { label: 'Aged Care', href: '/industries/aged-care' },
  { label: 'Accommodation', href: '/industries/student-accommodation' },
  { label: 'Hospitality',  href: '/industries/hospitality'           },
  { label: 'Commercial Real Estate', href: '/industries/commercial-real-estate' },
  { label: 'Property Management', href: '/industries/property-management' },
  { label: 'New Builds', href: '/industries/new-builds' },
  { label: 'Civil', href: '/industries/civil' },
];

const locations = [
  { label: 'Brisbane', href: '/plumber-brisbane' },
  { label: 'Logan', href: '/plumber-logan' },
  { label: 'Gold Coast', href: '/plumber-gold-coast' },
  { label: 'Ipswich', href: '/plumber-ipswich' },
];
---

<header class="bg-[#000000] border-b border-gray-800 sticky top-0 z-50 shadow-lg">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 lg:h-20">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0" aria-label="Pulse Plumbing, Gas & Civil — Home">
      <img
        src="/images/logo-dark.jpeg"
        alt="Pulse Plumbing, Gas & Civil"
        width="220"
        height="86"
        class="h-12 lg:h-16 w-auto"
        loading="eager"
      />
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden lg:flex items-center gap-1 text-sm font-semibold">

      <!-- Services -->
      <li class="relative group">
        <button class="flex items-center gap-1 px-3 py-2 text-gray-200 hover:text-[#10a2d5] rounded transition-colors">
          Services
          <svg class="w-3.5 h-3.5 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute top-full left-0 mt-1 w-[520px] bg-white border border-gray-200 rounded-xl shadow-lg
                    opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 p-4">
          <div class="grid grid-cols-2 gap-1">
            {services.map((s) => (
              <a href={s.href}
                 class="flex items-start gap-3 px-3 py-3 rounded-lg hover:bg-[#F0F5FA] transition-colors group/item">
                <div class="w-5 h-5 text-[#0172ae] flex-shrink-0 mt-0.5 group-hover/item:text-[#10a2d5] transition-colors" set:html={s.icon}></div>
                <div>
                  <p class="text-sm font-semibold text-[#000000] group-hover/item:text-[#0172ae] transition-colors leading-tight">{s.label}</p>
                  <p class="text-xs text-slate-400 mt-0.5">{s.desc}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between px-1">
            <span class="text-xs text-slate-400">All services available 24/7</span>
            <a href="/services" class="text-xs font-semibold text-[#0172ae] hover:text-[#10a2d5] transition-colors">View all →</a>
          </div>
        </div>
      </li>

      <!-- Industries -->
      <li class="relative group">
        <button class="flex items-center gap-1 px-3 py-2 text-gray-200 hover:text-[#10a2d5] rounded transition-colors">
          Industries
          <svg class="w-3.5 h-3.5 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute top-full left-0 mt-1 w-60 bg-white border border-gray-200 rounded-lg shadow-lg
                    opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
          <ul class="py-1.5">
            {industries.map((i) => (
              <li>
                <a href={i.href}
                   class="block px-4 py-2.5 text-sm text-slate-600 hover:text-[#0172ae] hover:bg-[#F0F5FA] transition-colors">
                  {i.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>

      <!-- Locations mega-dropdown -->
      <li class="relative group">
        <button class="flex items-center gap-1 px-3 py-2 text-gray-200 hover:text-[#10a2d5] rounded transition-colors">
          Locations
          <svg class="w-3.5 h-3.5 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-[700px] bg-white border border-gray-200 rounded-xl shadow-xl
                    opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 p-5">
          <div class="grid grid-cols-5 gap-4">
            {locationGroups.map((group) => (
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-2">{group.label}</p>
                <ul class="space-y-1">
                  {group.suburbs.map((s) => (
                    <li>
                      <a href={`/plumber-${s.slug}`}
                         class="block text-sm text-slate-600 hover:text-[#0172ae] transition-colors py-0.5 truncate">
                        {s.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between">
            <span class="text-xs text-slate-400">Servicing 130+ suburbs within 30km of Loganholme</span>
            <a href="/service-areas"
               class="text-sm font-semibold text-[#0172ae] hover:text-[#10a2d5] flex items-center gap-1 transition-colors">
              View all service areas →
            </a>
          </div>
        </div>
      </li>

      <li>
        <a href="/about" class="px-3 py-2 text-gray-200 hover:text-[#10a2d5] rounded transition-colors block">About</a>
      </li>
      <li>
        <a href="/civil" class="px-3 py-2 text-gray-200 hover:text-[#10a2d5] rounded transition-colors block">Civil</a>
      </li>
      <li>
        <a href="/contact" class="px-3 py-2 text-gray-200 hover:text-[#10a2d5] rounded transition-colors block">Contact</a>
      </li>
    </ul>

    <!-- Right CTAs -->
    <div class="flex items-center gap-3">

      <!-- Social icons — desktop only -->
      <div class="hidden lg:flex items-center gap-2">
        <a href="https://www.instagram.com/pulseplumbinggascivil" target="_blank" rel="noopener" aria-label="Pulse on Instagram"
           class="text-gray-500 hover:text-[#10a2d5] transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/Pulseqld" target="_blank" rel="noopener" aria-label="Pulse on Facebook"
           class="text-gray-500 hover:text-[#10a2d5] transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      </div>

      <!-- Phone — visible md+ -->
      <a href="tel:0452188420"
         data-track="call" data-call-number="emergency" data-call-location="header"
         class="hidden md:flex items-center gap-2 text-sm font-semibold text-gray-200 hover:text-[#10a2d5] transition-colors">
        <svg class="w-4 h-4 text-[#e12a39]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        {PHONE}
      </a>

      <!-- Book button -->
      <a href="/contact"
         class="bg-[#0172ae] hover:bg-[#10a2d5] text-white text-sm font-semibold px-4 py-2.5 rounded transition-colors hidden sm:inline-block">
        Get a Quote
      </a>

      <!-- Emergency — mobile prominent -->
      <a href={PHONE_HREF}
         data-track="emergency-cta" data-call-number="emergency" data-call-location="header"
         class="bg-[#e12a39] hover:bg-red-700 text-white text-sm font-bold px-4 py-2.5 rounded transition-colors sm:hidden">
        Call Now
      </a>

      <!-- Hamburger -->
      <button type="button" id="mobile-menu-btn" class="lg:hidden p-2 text-gray-400 hover:text-white transition-colors" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-800 bg-[#111111]">
    <div class="max-w-7xl mx-auto px-4 py-4 space-y-1">

      <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 px-3 pb-2 pt-1">Services</p>
      {services.map((s) => (
        <a href={s.href} class="flex items-center gap-3 px-3 py-2.5 hover:bg-gray-800 rounded transition-colors">
          <div class="w-5 h-5 text-[#10a2d5] flex-shrink-0" set:html={s.icon}></div>
          <div>
            <p class="text-sm font-semibold text-white">{s.label}</p>
            <p class="text-xs text-gray-500">{s.desc}</p>
          </div>
        </a>
      ))}

      <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 px-3 pb-2 pt-4">Industries</p>
      {industries.map((i) => (
        <a href={i.href} class="block px-3 py-2.5 text-sm text-gray-300 hover:text-[#10a2d5] hover:bg-gray-800 rounded transition-colors">{i.label}</a>
      ))}

      <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 px-3 pb-2 pt-4">Locations</p>
      {locationGroups.map((group) => (
        <>
          <p class="text-xs font-medium text-gray-500 px-3 pt-2 pb-1">{group.label}</p>
          {group.suburbs.map((s) => (
            <a href={`/plumber-${s.slug}`} class="block px-3 py-2 text-sm text-gray-300 hover:text-[#10a2d5] hover:bg-gray-800 rounded transition-colors">{s.name}</a>
          ))}
        </>
      ))}
      <a href="/service-areas" class="block px-3 py-2.5 text-sm font-semibold text-[#10a2d5] hover:bg-gray-800 rounded transition-colors">
        View all 130+ service areas →
      </a>

      <!-- Social links in mobile menu -->
      <div class="flex items-center gap-4 px-3 pt-3 pb-1">
        <a href="https://www.instagram.com/pulseplumbinggascivil" target="_blank" rel="noopener"
           class="flex items-center gap-2 text-sm text-gray-400 hover:text-[#10a2d5] transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          Instagram
        </a>
        <a href="https://www.facebook.com/Pulseqld" target="_blank" rel="noopener"
           class="flex items-center gap-2 text-sm text-gray-400 hover:text-[#10a2d5] transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
      </div>

      <div class="pt-3 flex flex-col gap-2 pb-2">
        <a href="tel:0452188420" data-track="emergency-cta" data-call-number="emergency" data-call-location="header" class="bg-[#e12a39] hover:bg-red-700 text-white font-bold text-sm px-4 py-3 rounded text-center transition-colors">
          📞 Emergency — 0452 188 420
        </a>
        <a href="tel:0721504175" data-track="call" data-call-number="office" data-call-location="header" class="bg-gray-700 hover:bg-gray-600 text-white font-semibold text-sm px-4 py-3 rounded text-center transition-colors">
          Office — 07 2150 4175
        </a>
        <a href="/contact" class="bg-[#0172ae] hover:bg-[#10a2d5] text-white font-semibold text-sm px-4 py-3 rounded text-center transition-colors">
          Get a Quote
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', (e) => {
    e.preventDefault();
    menu?.classList.toggle('hidden');
    const open = menu && !menu.classList.contains('hidden');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
