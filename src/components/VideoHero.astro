---
/**
 * VideoHero.astro
 *
 * Full-viewport hero with a looping background video.
 *
 * The poster image is the LCP element — it must always resolve and is the
 * only thing the browser renders on first paint. The video is progressive
 * enhancement loaded via IntersectionObserver, never blocking the main thread.
 *
 * Props
 * ─────
 * posterSrc   REQUIRED. Absolute-root path to a WebP/JPEG poster.
 *             Shown immediately; the video fades in on top when ready.
 * videoSrc    Path to the optimised .mp4 (H.264, ≤ 3 MB).
 * webmSrc     Path to the .webm (AV1) alternative. Served first when supported.
 * headline    H1 text.
 * subheadline Supporting paragraph.
 * ctaText / ctaHref          Primary CTA button.
 * secondaryCtaText / Href    Optional secondary CTA.
 */

export interface Props {
  videoSrc:           string;
  webmSrc?:           string;
  posterSrc:          string;
  headline:           string;
  subheadline:        string;
  ctaText:            string;
  ctaHref:            string;
  secondaryCtaText?:  string;
  secondaryCtaHref?:  string;
}

const {
  videoSrc,
  webmSrc,
  posterSrc,
  headline,
  subheadline,
  ctaText,
  ctaHref,
  secondaryCtaText,
  secondaryCtaHref,
} = Astro.props;
---

<section class="video-hero relative overflow-hidden bg-[#000000]" style="min-height: 560px;">

  <!-- ── Media layer ──────────────────────────────────────────────────── -->
  <div class="absolute inset-0" aria-hidden="true">

    <!--
      Poster: always rendered, always visible until the video loads.
      fetchpriority="high" because this IS the LCP element.
      The video fades in over it when IntersectionObserver fires.
    -->
    <img
      class="video-hero__poster absolute inset-0 w-full h-full object-cover"
      src={posterSrc}
      alt=""
      width="1280" height="720"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <!--
      Video: progressive enhancement.
      preload="none" — browser must not fetch video bytes during page load.
      The JS below starts loading + playback via IntersectionObserver.
      Hidden until JS promotes it (opacity-0 → opacity-100 after canplay).
    -->
    <video
      class="video-hero__video absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"
      muted
      loop
      playsinline
      preload="none"
      poster={posterSrc}
    >
      {webmSrc && <source data-src={webmSrc} type="video/webm; codecs=av01" />}
      <source data-src={videoSrc} type="video/mp4" />
    </video>

    <!-- noscript: poster only — no JS, no video, no broken state -->
    <noscript>
      <img
        class="absolute inset-0 w-full h-full object-cover"
        src={posterSrc}
        alt=""
        width="1280"
        height="720"
      />
    </noscript>
  </div>

  <!-- ── Overlays ─────────────────────────────────────────────────────── -->
  <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/20 to-transparent" aria-hidden="true"></div>

  <!-- ── Content ──────────────────────────────────────────────────────── -->
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-36 flex items-center">
    <div class="max-w-2xl">

      <p class="text-xs font-bold uppercase tracking-widest text-[#10a2d5] mb-5">
        QBCC Licensed · Civil Plumbing · SE Queensland
      </p>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#f19329] leading-tight mb-6 drop-shadow-lg">
        {headline}
      </h1>

      <p class="text-base sm:text-lg text-white/70 leading-relaxed mb-10 max-w-xl">
        {subheadline}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={ctaHref}
          class="inline-flex items-center justify-center gap-2 bg-[#0172ae] hover:bg-[#015d8e] text-white font-semibold px-8 py-3.5 rounded-full transition-colors shadow-lg shadow-[#0172ae]/30"
        >
          {ctaText}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
        {secondaryCtaText && secondaryCtaHref && (
          <a
            href={secondaryCtaHref}
            class="inline-flex items-center justify-center gap-2 border border-white/30 hover:border-white/60 text-white font-semibold px-8 py-3.5 rounded-full transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>
  </div>

</section>

<script>
/**
 * VideoHero progressive-enhancement loader.
 *
 * Strategy
 * ────────
 * 1. Bail immediately for prefers-reduced-motion — poster stays, no video.
 * 2. Bail for save-data or slow connections — poster stays.
 * 3. Otherwise: use IntersectionObserver to start loading the video only
 *    when the hero is in the viewport (not on page load).
 * 4. Move `data-src` → `src` on <source> elements just before play, so
 *    `preload="none"` is honoured until we actually need the video.
 * 5. Fade the video in (opacity 0 → 1) only once `canplay` fires, so the
 *    poster never flashes away before there is video content to show.
 */
(function () {
  // ── Reduced-motion check ───────────────────────────────────────────────
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  // ── Data-saver / slow connection check ────────────────────────────────
  const conn = (navigator as any).connection ?? (navigator as any).mozConnection ?? (navigator as any).webkitConnection;
  if (conn && (conn.saveData || ['2g', 'slow-2g'].includes(conn.effectiveType))) return;

  function initVideoHero(section: Element) {
    const video = section.querySelector<HTMLVideoElement>('.video-hero__video');
    if (!video) return;

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();

        // Promote data-src → src so the browser starts fetching
        video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
          s.src = s.dataset.src!;
        });
        video.load();

        video.addEventListener('canplay', () => {
          video.play().catch(() => {
            // Autoplay policy blocked it — poster stays visible, no error.
          });
          // Fade video in over the poster
          video.classList.remove('opacity-0');
        }, { once: true });
      },
      { threshold: 0.1 },
    );

    io.observe(section);
  }

  document.querySelectorAll<HTMLElement>('.video-hero').forEach(initVideoHero);
})();
</script>
