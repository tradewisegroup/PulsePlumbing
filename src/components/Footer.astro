---
const PHONE = '0452 188 420';
const PHONE_HREF = 'tel:0452188420';
const PHONE_OFFICE = '07 2150 4175';
const PHONE_OFFICE_HREF = 'tel:0721504175';
const EMAIL = 'admin@pulseqld.com.au';
const FACEBOOK_URL  = import.meta.env.FACEBOOK_URL  ?? 'https://www.facebook.com/Pulseqld';
const INSTAGRAM_URL = import.meta.env.INSTAGRAM_URL ?? 'https://www.instagram.com/pulseplumbinggascivil';

const services = [
  { label: 'Blocked Drains',            href: '/services/blocked-drains' },
  { label: 'Hot Water Systems',          href: '/services/hot-water-systems' },
  { label: 'Gas Fitting',               href: '/services/gas-fitting' },
  { label: 'InSinkErator Installation',  href: '/services/insinkerator' },
  { label: 'Drain Camera Inspection',   href: '/services/drain-camera' },
  { label: 'Backflow Prevention',       href: '/services/backflow-prevention' },
  { label: 'Preventative Maintenance',  href: '/services/preventative-maintenance' },
  { label: 'Civil Works',               href: '/civil' },
];

const industries = [
  { label: 'Retail', href: '/industries/retail' },
  { label: 'Childcare', href: '/industries/childcare' },
  { label: 'Education', href: '/industries/education' },
  { label: 'Aged Care', href: '/industries/aged-care' },
  { label: 'Commercial Real Estate', href: '/industries/commercial-real-estate' },
  { label: 'Property Management', href: '/industries/property-management' },
  { label: 'New Builds', href: '/industries/new-builds' },
];

const locations = [
  { label: 'Plumber Brisbane', href: '/plumber-brisbane' },
  { label: 'Plumber Logan', href: '/plumber-logan' },
  { label: 'Plumber Gold Coast', href: '/plumber-gold-coast' },
  { label: 'Plumber Ipswich', href: '/plumber-ipswich' },
];

const year = new Date().getFullYear();
---

<footer>
  <!-- Emergency band -->
  <div class="bg-[#e12a39]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-white font-semibold text-sm text-center sm:text-left">
        Plumbing emergency? We respond 24/7 — including nights, weekends &amp; public holidays.
      </p>
      <a href={PHONE_HREF}
         class="flex-shrink-0 bg-white text-[#e12a39] font-bold text-sm px-5 py-2.5 rounded hover:bg-red-50 transition-colors">
        Call Now — {PHONE}
      </a>
    </div>
  </div>

  <!-- Main footer body -->
  <div class="bg-[#000000] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">

        <!-- Brand -->
        <div class="lg:col-span-2">
          <a href="/" class="inline-block mb-5" aria-label="Pulse Plumbing, Gas & Civil — Home">
            <img
              src="/images/logo-dark.jpeg"
              alt="Pulse Plumbing, Gas & Civil"
              width="200"
              height="78"
              class="h-12 w-auto"
              loading="lazy"
            />
          </a>
          <p class="text-sm text-white/60 leading-relaxed mb-6 max-w-xs">
            QBCC-licensed plumbing, gas and civil contractor serving South-East Queensland. Available 24/7 including afterhours and weekends.
          </p>
          <div class="space-y-2.5 text-sm">
            <a href={PHONE_HREF}
               class="flex items-center gap-2.5 text-white/70 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-[#e12a39] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              {PHONE} <span class="text-white/35 text-xs ml-1">24/7 Emergency</span>
            </a>
            <a href={PHONE_OFFICE_HREF}
               class="flex items-center gap-2.5 text-white/70 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-[#0172ae] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              {PHONE_OFFICE} <span class="text-white/35 text-xs ml-1">Office</span>
            </a>
            <a href={`mailto:${EMAIL}`}
               class="flex items-center gap-2.5 text-white/70 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-[#0172ae] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {EMAIL}
            </a>
          </div>

          <!-- Social links -->
          <div class="mt-5 flex items-center gap-4">
            <a href="https://www.instagram.com/pulseplumbinggascivil" target="_blank" rel="noopener" aria-label="Pulse on Instagram"
               class="text-white/40 hover:text-[#10a2d5] transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a href="https://www.facebook.com/Pulseqld" target="_blank" rel="noopener" aria-label="Pulse on Facebook"
               class="text-white/40 hover:text-[#10a2d5] transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          </div>

          <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-white/35">
            <span>ABN: 62 652 712 699</span>
            <span>·</span>
            <span>QBCC Lic: 15021727</span>
            <span>·</span>
            <span>NSW Lic: 476430C</span>
          </div>
        </div>

        <!-- Services -->
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-4">Services</h3>
          <ul class="space-y-2.5">
            {services.map((s) => (
              <li>
                <a href={s.href} class="text-sm text-white/60 hover:text-white transition-colors">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Industries -->
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-4">Industries</h3>
          <ul class="space-y-2.5">
            {industries.map((i) => (
              <li>
                <a href={i.href} class="text-sm text-white/60 hover:text-white transition-colors">{i.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Locations + Company -->
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-4">Locations</h3>
          <ul class="space-y-2.5 mb-8">
            {locations.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-white/60 hover:text-white transition-colors">{l.label}</a>
              </li>
            ))}
          </ul>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-4">Company</h3>
          <ul class="space-y-2.5">
            <li><a href="/about" class="text-sm text-white/60 hover:text-white transition-colors">About Us</a></li>
            <li><a href="/careers" class="text-sm text-white/60 hover:text-white transition-colors">Careers</a></li>
            <li><a href="/civil" class="text-sm text-white/60 hover:text-white transition-colors">Civil</a></li>
            <li><a href="/knowledge-base" class="text-sm text-white/60 hover:text-white transition-colors">Knowledge Base</a></li>
            <li><a href="/strata-scorecard" class="text-sm text-white/60 hover:text-white transition-colors">Compliance Scorecard</a></li>
            <li><a href="/service-areas" class="text-sm text-white/60 hover:text-white transition-colors">Service Areas</a></li>
            <li><a href="/blog" class="text-sm text-white/60 hover:text-white transition-colors">Blog</a></li>
            <li><a href="/contact" class="text-sm text-white/60 hover:text-white transition-colors">Contact</a></li>
          </ul>

          {(FACEBOOK_URL || INSTAGRAM_URL) && (
            <div class="flex items-center gap-3 mt-6">
              {FACEBOOK_URL && (
                <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" aria-label="Pulse on Facebook"
                   class="w-8 h-8 rounded-lg bg-white/10 hover:bg-[#0172ae] flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
              )}
              {INSTAGRAM_URL && (
                <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Pulse on Instagram"
                   class="w-8 h-8 rounded-lg bg-white/10 hover:bg-[#0172ae] flex items-center justify-center transition-colors">
                  <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Legal bar -->
    <div class="border-t border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/35">
        <p>&copy; {year} Pulse Plumbing, Gas & Civil. All rights reserved.</p>
        <div class="flex items-center gap-5">
          <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-white transition-colors">Terms of Use</a>
          <a href="/disclaimer" class="hover:text-white transition-colors">Disclaimer</a>
          <a href="https://tradewisegroup.au/ai-websites" target="_blank" rel="noopener" class="hover:text-white transition-colors">Website by Tradewise</a>
        </div>
      </div>
    </div>
  </div>
</footer>
