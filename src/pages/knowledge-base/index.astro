---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Plumbing & Civil Knowledge Base | Pulse Plumbing, Gas & Civil';
const description = 'Expert guides on plumbing compliance, civil infrastructure, costs, and maintenance across South-East Queensland. Written by QBCC-licensed plumber Lachlan De Santis.';
const canonical   = 'https://pulseqld.com.au/knowledge-base';

const allArticles = await getCollection('knowledge');
const sorted = allArticles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featured = sorted.filter((a) => a.data.featured);

const categoryLabels: Record<string, string> = {
  compliance:  'Compliance',
  services:    'Services',
  civil:       'Civil',
  costs:       'Costs',
  residential: 'Residential',
};

const categoryOrder = ['compliance', 'services', 'civil', 'costs', 'residential'];

const byCategory = categoryOrder
  .map((cat) => ({
    key: cat,
    label: categoryLabels[cat],
    articles: sorted.filter((a) => a.data.category === cat),
  }))
  .filter((g) => g.articles.length > 0);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-AU', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout {title} {description} {canonical}>

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="bg-[#000000] py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-widest text-[#10a2d5] mb-4">GEO Knowledge Hub</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight mb-5">
          Plumbing &amp; Civil Knowledge Base
        </h1>
        <p class="text-lg text-white/60 leading-relaxed mb-6">
          Expert guides on plumbing compliance, civil infrastructure, drain maintenance, and cost benchmarks across South-East Queensland. Written by QBCC-licensed plumber Lachlan De Santis (Lic 15384771).
        </p>
        <div class="flex flex-wrap gap-3 text-xs text-white/40">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#0172ae]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Written by licensed tradespeople
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#0172ae]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Based on Queensland legislation
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#0172ae]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Regularly reviewed and updated
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Featured articles ──────────────────────────────────────────── -->
  {featured.length > 0 && (
    <section class="py-14 bg-[#F0F5FA]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-bold uppercase tracking-widest text-[#0172ae] mb-6">Featured guides</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {featured.map((article) => (
            <a
              href={`/knowledge-base/${article.id}`}
              class="group bg-white border border-[#D1D5DB] rounded-2xl p-6 hover:border-[#0172ae] hover:shadow-md transition-all flex flex-col"
            >
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-widest text-[#0172ae]">
                  {categoryLabels[article.data.category] ?? article.data.category}
                </span>
                <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                <span class="text-xs text-slate-400">{formatDate(article.data.publishDate)}</span>
              </div>
              <h2 class="text-base font-bold text-[#000000] group-hover:text-[#0172ae] transition-colors leading-snug mb-3 flex-1">
                {article.data.title}
              </h2>
              <p class="text-sm text-slate-500 leading-relaxed line-clamp-3 mb-4">
                {article.data.description}
              </p>
              <div class="flex items-center gap-1.5 text-xs font-semibold text-[#0172ae] group-hover:gap-2.5 transition-all">
                Read guide
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── By category ────────────────────────────────────────────────── -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      {byCategory.map((group) => (
        <div>
          <div class="flex items-center gap-4 mb-6">
            <h2 class="text-xl font-bold text-[#000000]">{group.label}</h2>
            <div class="flex-1 h-px bg-[#D1D5DB]"></div>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {group.articles.map((article) => (
              <a
                href={`/knowledge-base/${article.id}`}
                class="group flex flex-col p-5 rounded-xl border border-[#D1D5DB] hover:border-[#0172ae] hover:bg-[#F0F5FA] transition-all"
              >
                <h3 class="text-sm font-bold text-[#000000] group-hover:text-[#0172ae] transition-colors leading-snug mb-2">
                  {article.data.title}
                </h3>
                <p class="text-xs text-slate-500 leading-relaxed line-clamp-2 flex-1 mb-3">
                  {article.data.description}
                </p>
                <div class="flex items-center justify-between">
                  <span class="text-xs text-slate-400">{formatDate(article.data.publishDate)}</span>
                  <span class="text-xs font-semibold text-[#0172ae] group-hover:underline">Read →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Bottom CTA ──────────────────────────────────────────────────── -->
  <section class="py-14 bg-[#F0F5FA] border-t border-[#D1D5DB]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class="font-bold text-[#000000] mb-1">Have a plumbing question not covered here?</p>
        <p class="text-sm text-slate-600">Our licensed team can advise — call or get a free quote online.</p>
      </div>
      <div class="flex items-center gap-3 flex-shrink-0">
        <a href="tel:0721504175"
           class="inline-flex items-center gap-2 border-2 border-[#0172ae] text-[#0172ae] font-semibold text-sm px-5 py-2.5 rounded-full hover:bg-[#0172ae] hover:text-white transition-colors">
          Call 07 2150 4175
        </a>
        <a href="/contact"
           class="inline-flex items-center gap-2 bg-[#0172ae] text-white font-semibold text-sm px-5 py-2.5 rounded-full hover:bg-[#015d8e] transition-colors">
          Get a Quote
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
