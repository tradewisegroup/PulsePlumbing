---
import CivilLayout from '../../layouts/CivilLayout.astro';
import CivilEnquiryForm from '../../components/forms/CivilEnquiryForm.jsx';
import VideoHero from '../../components/VideoHero.astro';

const FORM_ID = import.meta.env.HUBSPOT_CIVIL_FORM_ID ?? '';
const SITE    = 'https://pulseqld.com.au';

const PROCESS_STEPS = [
  {
    step: '01',
    title: 'Design review',
    description: 'We review the stormwater design against council requirements and the approved operational works conditions. For design-and-construct projects, we engage a civil hydraulic engineer to model the catchment, size the pipe network and design any required drainage structures.',
  },
  {
    step: '02',
    title: 'Installation',
    description: 'We install pit and pipe networks, open channel drainage, detention basins and WSUD structures. All earthworks are managed under an erosion and sediment control plan in accordance with Queensland environmental requirements.',
  },
  {
    step: '03',
    title: 'Documentation & sign-off',
    description: 'GPS as-constructed drawings, CCTV inspection reports and council compliance documentation are compiled and submitted. We manage the sign-off process with council and the relevant approval authority.',
  },
];

const FAQS = [
  {
    q: 'Do you install stormwater drainage for residential subdivisions?',
    a: 'Yes. Stormwater pit and pipe installation for residential and commercial subdivisions is part of our standard civil scope across Brisbane, Logan, Gold Coast and Ipswich. We install the full drainage network from lot boundaries through to the main outfall, coordinating with council requirements throughout.',
  },
  {
    q: 'Can you install detention basins and gross pollutant traps?',
    a: 'Yes. We construct detention basins, gross pollutant traps, trash screens and sediment basins as part of council-approved stormwater designs. We manage installation of pre-cast and in-situ structures to the council-approved hydraulic design.',
  },
  {
    q: 'Do you handle kerb and channel drainage works?',
    a: 'Yes. We install kerb and channel, lintel drains, side entry pits and kerb adaptors in coordination with the road works contractor. Inlet and outlet levels are checked against finished road levels to confirm flow paths are correct.',
  },
  {
    q: 'What compliance documentation do you provide?',
    a: 'We provide GPS as-constructed drawings, CCTV inspection reports for any council-maintained drainage, and erosion and sediment control documentation. All materials are submitted to council as part of the operational works compliance sign-off.',
  },
  {
    q: 'Which areas do you cover for stormwater drainage works?',
    a: 'We operate across Brisbane, Logan City, Redland City, Gold Coast (north) and Ipswich — delivering stormwater drainage works for residential and commercial developments across South-East Queensland.',
  },
];

const schema = {
  '@graph': [
    {
      '@type':       'Service',
      '@id':         `${SITE}/civil/stormwater#service`,
      name:          'Stormwater Drainage Construction — South-East Queensland',
      serviceType:   'Stormwater Drainage Installation',
      provider: {
        '@type': 'Organization',
        '@id':   `${SITE}/#organization`,
      },
      areaServed: [
        { '@type': 'City',  name: 'Brisbane'  },
        { '@type': 'City',  name: 'Logan'     },
        { '@type': 'City',  name: 'Gold Coast'},
        { '@type': 'City',  name: 'Ipswich'   },
        { '@type': 'State', name: 'Queensland'},
      ],
      description:
        'QBCC-licensed stormwater drainage construction across Brisbane and South-East Queensland. Stormwater pit and pipe networks, open channel drainage, detention basins, WSUD structures and council compliance documentation for residential and commercial developments.',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name:    'Stormwater Drainage Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Stormwater Pit & Pipe Installation' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Open Channel Drainage' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Detention Basins & WSUD Structures' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Gross Pollutant Traps' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Kerb & Channel Works' } },
        ],
      },
    },
    {
      '@type':    'FAQPage',
      mainEntity: FAQS.map(f => ({
        '@type':        'Question',
        name:           f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<CivilLayout
  pageTitle="Stormwater Drainage Construction — South-East Queensland"
  pageSubtitle="Stormwater pit and pipe networks, open channel drainage, detention basins and WSUD structures for residential subdivisions, commercial developments and councils across Brisbane, Logan, Gold Coast and Ipswich."
  metaTitle="Stormwater Drainage Construction Brisbane & SEQ | Pulse Plumbing Civil"
  metaDescription="QBCC-licensed stormwater drainage construction across Brisbane, Logan and Gold Coast. Pit and pipe networks, detention basins, gross pollutant traps and council compliance documentation."
  activeSlug="stormwater"
  schema={schema}
>

  <!-- Capability overview -->
  <section class="py-20 bg-[#F0F5FA]" aria-labelledby="capability-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-start">

        <div>
          <div class="inline-flex items-center gap-2 bg-[#0172ae]/10 border border-[#0172ae]/20 rounded-full px-3 py-1 mb-5">
            <span class="text-xs font-semibold text-[#0172ae]">Stormwater</span>
          </div>
          <h2 id="capability-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-5 leading-tight">
            Stormwater drainage for developers, builders and councils
          </h2>
          <p class="text-[#1a1a1a] text-base leading-relaxed mb-5">
            We deliver stormwater drainage for residential subdivisions, commercial precincts and council infrastructure projects across South-East Queensland — from pit and pipe networks and open channel drainage through to detention basins and water sensitive urban design structures.
          </p>
          <p class="text-[#1a1a1a] text-base leading-relaxed">
            We work as both principal contractor and subcontractor. We manage all earthworks under an erosion and sediment control plan, coordinate with council throughout construction, and deliver full as-constructed documentation for operational works compliance sign-off.
          </p>
        </div>

        <div class="space-y-4">
          {[
            { title: 'Stormwater pit & pipe networks', desc: 'Full drainage network installation from lot boundaries to outfall. Precast and in-situ pits, gullies, kerb inlets and junction structures.' },
            { title: 'Open channel drainage', desc: 'Grassed swales, concrete-lined channels and earthen drains constructed to the council-approved hydraulic design.' },
            { title: 'Detention basins & WSUD structures', desc: 'Detention basins, gross pollutant traps, trash screens, sediment basins and biofiltration rain gardens installed to council WSUD guidelines.' },
            { title: 'Kerb & channel works', desc: 'Kerb and channel, lintel drains, side entry pits and kerb adaptors installed in coordination with the road works programme.' },
            { title: 'Council compliance documentation', desc: 'GPS as-constructed drawings, CCTV inspection reports and ESC documentation compiled for council operational works sign-off.' },
          ].map(item => (
            <div class="bg-white border border-slate-200 rounded-xl p-5">
              <h3 class="font-semibold text-[#000000] text-sm mb-1">{item.title}</h3>
              <p class="text-[#1a1a1a] text-xs leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 bg-white" aria-labelledby="process-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 id="process-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-4">How we deliver a stormwater project</h2>
        <p class="text-[#1a1a1a] text-lg">From design review to council sign-off — straightforward, documented at every step.</p>
      </div>
      <div class="space-y-4">
        {PROCESS_STEPS.map(step => (
          <div class="bg-[#F0F5FA] border border-slate-200 rounded-2xl p-7 flex gap-6 items-start">
            <div class="text-4xl font-black text-[#0172ae]/20 leading-none flex-shrink-0 w-12 text-center">{step.step}</div>
            <div>
              <h3 class="font-bold text-[#000000] text-lg mb-2">{step.title}</h3>
              <p class="text-[#1a1a1a] text-sm leading-relaxed">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-20 bg-[#F0F5FA]" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="faq-heading" class="text-3xl font-bold text-[#000000] mb-10">Frequently asked questions</h2>
      <div class="space-y-4">
        {FAQS.map(faq => (
          <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none font-semibold text-[#000000] hover:text-[#0172ae] transition-colors">
              {faq.q}
              <svg class="w-4 h-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-6 text-[#1a1a1a] text-sm leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CivilEnquiryForm formId={FORM_ID} initialProjectType="stormwater" client:load slot="enquiry-form" />

  <VideoHero
    slot="hero"
    videoSrc="/videos/civil-excavator-birdseye.mp4"
    headline="Stormwater Drainage Construction — South-East Queensland"
    subheadline="Pit and pipe networks, open channel drainage, detention basins and WSUD structures for residential subdivisions, commercial developments and councils across SEQ."
    ctaText="Submit an RFQ"
    ctaHref="/civil/contact"
  />

</CivilLayout>
