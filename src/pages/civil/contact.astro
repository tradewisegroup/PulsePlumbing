---
import CivilLayout from '../../layouts/CivilLayout.astro';
import CallLink from '../../components/CallLink.astro';
import CivilRFQForm from '../../components/forms/CivilRFQForm.jsx';

const FORM_ID = import.meta.env.HUBSPOT_CIVIL_FORM_ID ?? '';
const SITE    = 'https://pulseqld.com.au';
const PHONE   = '0452 188 420';
const EMAIL   = 'admin@pulseqld.com.au';

// ─── "What to include" checklist ─────────────────────────────────────────────

const CHECKLIST_ITEMS = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    heading: 'Project location and scope description',
    detail:  'Site address or suburb, the nature of the civil plumbing works, the size of the network or development, and any staging requirements.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
    heading: 'Relevant drawings or DA documents (if available)',
    detail:  'Hydraulic design drawings, engineering specifications, development approval conditions, distributor-retailer design guidelines, or a project brief. Email large files directly to admin@pulseqld.com.au.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
    heading: 'Required start date and completion timeline',
    detail:  'Anticipated start date, overall programme, and any critical milestones — practical completion date, infrastructure agreement submission, or tender closing date.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="12" y2="16"/></svg>`,
    heading: 'Council or client specifications applicable',
    detail:  'Name of the relevant council, distributor-retailer (QUU, Logan Water, Unitywater), or head contractor, and any specification documents that govern the scope.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
    heading: 'Whether SWMS, insurance certs or pre-qual docs are required',
    detail:  'Let us know upfront if you need our QBCC licence certificate, public liability certificate of currency, Workers Compensation certificate, SWMS templates, or capability statement before issuing the RFQ. We can provide these immediately.',
  },
];

// ─── Credential & contact cards ───────────────────────────────────────────────

const CREDENTIAL_ITEMS = [
  { label: 'Direct enquiries', value: EMAIL,       href: `mailto:${EMAIL}`,    mono: false },
  { label: 'Phone',            value: PHONE,        href: `tel:0452188420`,     mono: false },
  { label: 'QBCC Licence',     value: '15384771',   href: null,                 mono: true  },
  { label: 'NSW Licence',      value: '476430C',    href: null,                 mono: true  },
  { label: 'ABN',              value: '62 652 712 699', href: null,             mono: true  },
  { label: 'Public Liability', value: '$20M',       href: null,                 mono: false },
  { label: 'Workers Comp',     value: 'Current (WorkCover QLD)', href: null,   mono: false },
];

// ─── Schema ───────────────────────────────────────────────────────────────────

const schema = {
  '@graph': [
    {
      '@type':       'ContactPage',
      '@id':         `${SITE}/civil/contact#page`,
      name:          'Submit a Civil Project Enquiry — Pulse Plumbing & Gas',
      description:
        'Submit a civil project RFQ or infrastructure enquiry to Pulse Plumbing & Gas. QBCC-licensed civil plumbing contractor serving SE Queensland. Responses within one business day.',
      url:           `${SITE}/civil/contact`,
      mainEntity: {
        '@type':     'Organization',
        '@id':       `${SITE}/#organization`,
      },
    },
  ],
};
---

<CivilLayout
  pageTitle="Enquiries"
  pageSubtitle="Submit a civil project RFQ or infrastructure enquiry. We respond within 1 business day — for urgent matters call 0452 188 420."
  metaTitle="Submit a Civil Project Enquiry — Pulse Plumbing & Gas"
  metaDescription="Submit a civil project RFQ or infrastructure maintenance enquiry to Pulse Plumbing & Gas — QBCC-licensed civil plumbing contractor across SE Queensland. Water mains, sewer construction, stormwater and maintenance contracts. Response within one business day."
  activeSlug="__contact"
  schema={schema}
>

  <!-- ══════════════════════════════════════════════════════════════════════════
       §1 WHAT TO INCLUDE CHECKLIST
       Procurement language — helps the enquirer write a better brief and
       pre-qualifies the lead before it reaches our civil team.
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-[#F0F5FA]" aria-labelledby="checklist-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[380px_1fr] gap-14 items-start">

        <!-- Left: section identity -->
        <div class="lg:pt-1">
          <div class="flex items-center gap-2 mb-3" aria-hidden="true">
            <div class="w-1 h-5 bg-[#0172ae] rounded-full"></div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.15em]">Before You Submit</span>
          </div>
          <h2 id="checklist-heading" class="text-2xl sm:text-3xl font-bold text-[#000000] mb-4 leading-snug">
            What to include in your enquiry
          </h2>
          <p class="text-[#1a1a1a] text-sm leading-relaxed mb-6">
            The more detail you provide upfront, the faster and more specific our response will be. Use this checklist to ensure your enquiry covers the information our civil team needs to assess your project scope.
          </p>
          <p class="text-sm text-[#1a1a1a] leading-relaxed">
            If you have drawings or DA documents ready, email them to{' '}
            <a href={`mailto:${EMAIL}`} class="text-[#0172ae] hover:underline font-medium">{EMAIL}</a>{' '}
            with your company name in the subject line, then reference the project in the form below.
          </p>
        </div>

        <!-- Right: checklist items -->
        <div class="space-y-3">
          {CHECKLIST_ITEMS.map((item, i) => (
            <div class="bg-white border border-slate-200 rounded-2xl p-5 flex items-start gap-4 hover:border-[#0172ae]/30 hover:shadow-sm transition-all group">
              <!-- Diamond bullet -->
              <div class="w-9 h-9 rounded-lg bg-[#0172ae]/8 group-hover:bg-[#0172ae]/14 flex items-center justify-center flex-shrink-0 text-[#0172ae] transition-colors" aria-hidden="true" set:html={item.icon}></div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[10px] font-bold text-[#0172ae] tabular-nums">◆ {String(i + 1).padStart(2, '0')}</span>
                  <h3 class="font-semibold text-[#000000] text-sm leading-snug">{item.heading}</h3>
                </div>
                <p class="text-[#1a1a1a] text-xs leading-relaxed">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       §2 CREDENTIALS & CONTACT DETAILS PANEL
       Targets procurement officers who need to verify contractor details
       before issuing an RFQ. Cards match the dark/professional tone.
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-16 bg-white border-t border-slate-100" aria-labelledby="credentials-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-2" aria-hidden="true">
            <div class="w-1 h-4 bg-[#0172ae] rounded-full"></div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.15em]">Contractor Details</span>
          </div>
          <h2 id="credentials-heading" class="text-xl font-bold text-[#000000]">
            Contact details &amp; credentials
          </h2>
        </div>
        <p class="text-xs text-slate-400 max-w-xs leading-relaxed">
          Pre-qualification documentation — QBCC licence certificate, insurance certificates of currency, SWMS templates and capability statement — available on request.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {CREDENTIAL_ITEMS.map(item => (
          <div class="bg-[#F0F5FA] border border-slate-200 rounded-xl px-5 py-4">
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wide mb-1.5">
              {item.label}
            </div>
            {item.href?.startsWith('tel:') ? (
              <CallLink
                location="hero"
                numberType="emergency"
                staticNumber
                class={`text-sm font-semibold text-[#0172ae] hover:text-[#015d8e] transition-colors ${item.mono ? 'font-mono' : ''}`}
              >
                {item.value}
              </CallLink>
            ) : item.href ? (
              <a
                href={item.href}
                class={`text-sm font-semibold text-[#0172ae] hover:text-[#015d8e] transition-colors ${item.mono ? 'font-mono' : ''}`}
              >
                {item.value}
              </a>
            ) : (
              <span class={`text-sm font-semibold text-[#000000] ${item.mono ? 'font-mono' : ''}`}>
                {item.value}
              </span>
            )}
          </div>
        ))}
      </div>

      <!-- Response time commitment -->
      <div class="mt-6 bg-[#0172ae]/5 border border-[#0172ae]/15 rounded-2xl px-6 py-5 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-10 h-10 rounded-lg bg-[#0172ae]/10 flex items-center justify-center text-xl flex-shrink-0" aria-hidden="true">
          ⏱️
        </div>
        <div>
          <div class="font-semibold text-[#000000] text-sm mb-0.5">Response time commitment</div>
          <p class="text-[#1a1a1a] text-xs leading-relaxed">
            We confirm capability and availability for all civil project enquiries within <strong>one business day</strong>.
            For formal tender submissions with a closing date, note the deadline in your enquiry and we will prioritise accordingly.
            For urgent infrastructure matters, call <CallLink location="emergency" numberType="emergency" class="text-[#0172ae] font-semibold hover:underline">{PHONE}</CallLink>.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ── RFQ form (renders inside CivilLayout section 6) ─────────────────── -->
  <CivilRFQForm formId={FORM_ID} client:visible slot="enquiry-form" />

</CivilLayout>
