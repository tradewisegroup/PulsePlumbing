---
import CivilLayout from '../../layouts/CivilLayout.astro';
import CivilEnquiryForm from '../../components/forms/CivilEnquiryForm.jsx';
import VideoHero from '../../components/VideoHero.astro';

const FORM_ID = import.meta.env.HUBSPOT_CIVIL_FORM_ID ?? '';
const SITE    = 'https://pulseqld.com.au';

const PROCESS_STEPS = [
  {
    step: '01',
    title: 'Design & approvals',
    description: 'We review the sewer design and manage the infrastructure agreement approvals with QUU, Logan Water or Unitywater. For design-and-construct projects, we engage a civil engineer to prepare hydraulic documentation and manage the distributor-retailer submission process.',
  },
  {
    step: '02',
    title: 'Installation',
    description: 'We excavate, lay gravity sewer mains, install manholes, connect lots and construct pump stations where required. Road opening permits, traffic control and road reinstatement are all managed by our team.',
  },
  {
    step: '03',
    title: 'CCTV inspection & handover',
    description: 'Every gravity sewer main is CCTV inspected before handover. Pressure testing, manhole inspections and as-constructed documentation are compiled and submitted to the distributor-retailer for infrastructure agreement sign-off.',
  },
];

const FAQS = [
  {
    q: 'Do you install sewer mains for residential subdivisions?',
    a: 'Yes. Sewer reticulation for residential and commercial subdivisions is a core part of our civil scope across South-East Queensland and Northern NSW. We install gravity sewer mains, connect individual lots and construct manholes, then coordinate handover with QUU, Logan Water or Unitywater.',
  },
  {
    q: 'Do you connect individual lots to the sewer network?',
    a: 'Yes. We install individual lot connections from the sewer main to the property boundary. For live road connections, we manage the road opening permit, traffic control and road reinstatement. All connections are documented on as-constructed plans.',
  },
  {
    q: 'Can you construct pump stations and rising mains?',
    a: 'Yes. Where gravity drainage is not achievable, we design and construct sewage pump stations and rising mains to the relevant distributor-retailer specification. We manage wet well construction, pump installation and rising main installation as part of the complete scope.',
  },
  {
    q: 'What does the CCTV inspection process involve before handover?',
    a: 'Before handover to the distributor-retailer, every gravity sewer main is inspected with a crawler CCTV camera. The footage is reviewed, any defects are documented and repaired, and a CCTV report is prepared as part of the infrastructure agreement documentation package.',
  },
  {
    q: 'Which areas do you cover for sewer construction?',
    a: 'We operate across Brisbane, Logan City, Redland City, Gold Coast (north) and Ipswich — working with QUU, Logan Water, Gold Coast Water and Unitywater across their respective service areas in South-East Queensland.',
  },
];

const schema = {
  '@graph': [
    {
      '@type':       'Service',
      '@id':         `${SITE}/civil/sewer-construction#service`,
      name:          'Sewer Construction — South-East Queensland',
      serviceType:   'Sewer Construction',
      provider: {
        '@type': 'Organization',
        '@id':   `${SITE}/#organization`,
      },
      areaServed: [
        { '@type': 'City',  name: 'Brisbane'  },
        { '@type': 'City',  name: 'Logan'     },
        { '@type': 'City',  name: 'Gold Coast'},
        { '@type': 'City',  name: 'Ipswich'   },
        { '@type': 'State', name: 'Queensland'},
      ],
      description:
        'QBCC-licensed sewer construction across Brisbane and South-East Queensland. Gravity sewer installation, lot connections, manhole construction, pump stations and full infrastructure agreement documentation for QUU, Logan Water and Unitywater.',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name:    'Sewer Construction Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Gravity Sewer Main Installation' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Lot Connections' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Manhole Construction' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Pump Stations & Rising Mains' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CCTV Inspection & Handover' } },
        ],
      },
    },
    {
      '@type':    'FAQPage',
      mainEntity: FAQS.map(f => ({
        '@type':        'Question',
        name:           f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<CivilLayout
  pageTitle="Sewer Construction — South-East Queensland"
  pageSubtitle="Gravity sewer installation, lot connections, manhole construction, pump stations and rising mains for residential subdivisions and commercial developments across South-East Queensland and Northern NSW. QBCC licensed."
  metaTitle="Sewer Construction Brisbane & SEQ | Pulse Plumbing Civil"
  metaDescription="QBCC-licensed sewer construction across Brisbane, Logan and Gold Coast. Gravity sewer installation, lot connections, pump stations and full infrastructure agreement documentation for QUU, Logan Water and Unitywater."
  activeSlug="sewer-construction"
  schema={schema}
>

  <!-- Capability overview -->
  <section class="py-20 bg-[#F0F5FA]" aria-labelledby="capability-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-start">

        <div>
          <div class="inline-flex items-center gap-2 bg-[#0172ae]/10 border border-[#0172ae]/20 rounded-full px-3 py-1 mb-5">
            <span class="text-xs font-semibold text-[#0172ae]">Sewer Construction</span>
          </div>
          <h2 id="capability-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-5 leading-tight">
            Sewer construction for developers, builders and councils
          </h2>
          <p class="text-[#1a1a1a] text-base leading-relaxed mb-5">
            We deliver the full sewer construction scope on residential subdivisions, commercial precincts and council infrastructure projects across South-East Queensland — from gravity sewer mains and lot connections through to pump stations and rising mains.
          </p>
          <p class="text-[#1a1a1a] text-base leading-relaxed">
            We work as both principal contractor and subcontractor. We manage the infrastructure agreement approvals with the distributor-retailer, attend all hold points, complete CCTV inspection prior to handover, and deliver the full as-constructed documentation package.
          </p>
        </div>

        <div class="space-y-4">
          {[
            { title: 'Gravity sewer main installation', desc: 'Gravity sewer reticulation for residential and commercial subdivisions. Precast concrete manholes included.' },
            { title: 'Lot connections', desc: 'Individual property connections from the sewer main to the property boundary. Road opening permits, traffic control and reinstatement managed.' },
            { title: 'Manhole construction', desc: 'Precast concrete manhole construction and installation to distributor-retailer specification.' },
            { title: 'Pump stations & rising mains', desc: 'Sewage pump stations and rising mains where gravity drainage is not achievable. Full design and construction scope available.' },
            { title: 'CCTV inspection & handover', desc: 'Crawler CCTV inspection of all gravity sewer mains before handover. Full as-constructed documentation for infrastructure agreement submission.' },
          ].map(item => (
            <div class="bg-white border border-slate-200 rounded-xl p-5">
              <h3 class="font-semibold text-[#000000] text-sm mb-1">{item.title}</h3>
              <p class="text-[#1a1a1a] text-xs leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 bg-white" aria-labelledby="process-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 id="process-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-4">How we deliver a sewer construction project</h2>
        <p class="text-[#1a1a1a] text-lg">From design approvals to CCTV inspection and handover — documented at every step.</p>
      </div>
      <div class="space-y-4">
        {PROCESS_STEPS.map(step => (
          <div class="bg-[#F0F5FA] border border-slate-200 rounded-2xl p-7 flex gap-6 items-start">
            <div class="text-4xl font-black text-[#0172ae]/20 leading-none flex-shrink-0 w-12 text-center">{step.step}</div>
            <div>
              <h3 class="font-bold text-[#000000] text-lg mb-2">{step.title}</h3>
              <p class="text-[#1a1a1a] text-sm leading-relaxed">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-20 bg-[#F0F5FA]" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="faq-heading" class="text-3xl font-bold text-[#000000] mb-10">Frequently asked questions</h2>
      <div class="space-y-4">
        {FAQS.map(faq => (
          <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none font-semibold text-[#000000] hover:text-[#0172ae] transition-colors">
              {faq.q}
              <svg class="w-4 h-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-6 text-[#1a1a1a] text-sm leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CivilEnquiryForm formId={FORM_ID} initialProjectType="sewer-construction" client:visible slot="enquiry-form" />

  <VideoHero
    slot="hero"
    videoSrc="/videos/civil-rochdale-digger.mp4"
    posterSrc="/images/poster-civil-rochdale-digger.webp"
    headline="Sewer Construction — South-East Queensland"
    subheadline="Gravity sewer installation, lot connections, manhole construction and pump stations for residential subdivisions and commercial developments across SEQ and Northern NSW."
    ctaText="Submit an RFQ"
    ctaHref="/civil/contact"
  />

</CivilLayout>
