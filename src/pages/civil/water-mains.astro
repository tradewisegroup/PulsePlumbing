---
import CivilLayout from '../../layouts/CivilLayout.astro';
import CivilEnquiryForm from '../../components/forms/CivilEnquiryForm.jsx';
import VideoHero from '../../components/VideoHero.astro';

const FORM_ID = import.meta.env.HUBSPOT_CIVIL_FORM_ID ?? '';
const SITE    = 'https://pulseqld.com.au';

const PROCESS_STEPS = [
  {
    step: '01',
    title: 'Design & approvals',
    description: 'We review the hydraulic design and work through the relevant infrastructure agreement approvals with QUU, Logan Water or Gold Coast Water before breaking ground. For design-and-construct projects, we prepare or check the hydraulic drawings and manage the submission process.',
  },
  {
    step: '02',
    title: 'Excavation & installation',
    description: 'We trench, lay pipe, install fittings, hydrants and valves, and make all service connections to property boundaries. Live network tie-ins are coordinated directly with the distributor-retailer to minimise supply interruption.',
  },
  {
    step: '03',
    title: 'Testing & handover',
    description: 'Every main is pressure-tested and disinfected before commissioning. We compile the full as-constructed documentation package and manage the infrastructure agreement submission through to conditional acceptance.',
  },
];

const FAQS = [
  {
    q: 'Do you install water mains for residential subdivisions?',
    a: 'Yes. Water main installation for residential and commercial subdivisions is a core part of what we do across South-East Queensland and Northern NSW. We install reticulation mains, hydrants, gate valves and service connections to property boundaries, then coordinate handover with the relevant distributor-retailer — QUU, Logan Water or Gold Coast Water.',
  },
  {
    q: 'Can you connect a new development to the existing council water network?',
    a: 'Yes. We manage live water main connections and tie-ins to existing council mains. This includes coordinating the shutdown with the distributor-retailer, completing the physical connection, disinfecting and pressure-testing the new section, and collecting bacteriological clearance before commissioning.',
  },
  {
    q: 'Do you carry out water main connections to individual lots?',
    a: 'Yes. We install individual property service connections from the water main to the property boundary, including road opening permits, traffic control and road reinstatement where required. All connections are documented on as-constructed plans.',
  },
  {
    q: 'What documentation do you provide at project completion?',
    a: 'We provide GPS as-constructed drawings, pressure test certificates, disinfection and bacteriological clearance records, and all material certification required for the infrastructure agreement submission. We manage the submission through to conditional acceptance with the distributor-retailer.',
  },
  {
    q: 'Which areas of South-East Queensland do you cover?',
    a: 'We operate across Brisbane, Logan City, Redland City, Gold Coast (north) and Ipswich — working with QUU, Logan Water, Gold Coast Water and Unitywater across their respective service areas.',
  },
];

const schema = {
  '@graph': [
    {
      '@type':       'Service',
      '@id':         `${SITE}/civil/water-mains#service`,
      name:          'Water Main Installation — South-East Queensland',
      serviceType:   'Water Main Installation',
      provider: {
        '@type': 'Organization',
        '@id':   `${SITE}/#organization`,
      },
      areaServed: [
        { '@type': 'City',  name: 'Brisbane'  },
        { '@type': 'City',  name: 'Logan'     },
        { '@type': 'City',  name: 'Gold Coast'},
        { '@type': 'City',  name: 'Ipswich'   },
        { '@type': 'State', name: 'Queensland'},
      ],
      description:
        'QBCC-licensed water main installation for residential subdivisions, commercial developments and councils across Brisbane and South-East Queensland. New water main installation, service connections, live tie-ins and full infrastructure agreement documentation.',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name:    'Water Main Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Water Main Installation' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Service Connections to Property Boundaries' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Live Water Main Connections & Tie-ins' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Pressure Testing & Disinfection' } },
        ],
      },
    },
    {
      '@type':    'FAQPage',
      mainEntity: FAQS.map(f => ({
        '@type':        'Question',
        name:           f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<CivilLayout
  pageTitle="Water Main Installation — South-East Queensland"
  pageSubtitle="New water main installation, service connections and live tie-ins for residential subdivisions, commercial developments and councils across South-East Queensland and Northern NSW. QBCC licensed."
  metaTitle="Water Main Installation Brisbane & SEQ | Pulse Plumbing Civil"
  metaDescription="QBCC-licensed water main installation across Brisbane, Logan and Gold Coast. New water main installation, service connections to property boundaries, live tie-ins and full infrastructure agreement documentation."
  activeSlug="water-mains"
  schema={schema}
>

  <!-- Capability overview -->
  <section class="py-20 bg-[#F0F5FA]" aria-labelledby="capability-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-start">

        <div>
          <div class="inline-flex items-center gap-2 bg-[#0172ae]/10 border border-[#0172ae]/20 rounded-full px-3 py-1 mb-5">
            <span class="text-xs font-semibold text-[#0172ae]">Water Mains</span>
          </div>
          <h2 id="capability-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-5 leading-tight">
            Water main installation for developers, builders and councils
          </h2>
          <p class="text-[#1a1a1a] text-base leading-relaxed mb-5">
            We deliver the full water main scope on residential subdivisions, commercial precincts and council infrastructure projects across South-East Queensland — from new reticulation and service connections through to live tie-ins on the existing network.
          </p>
          <p class="text-[#1a1a1a] text-base leading-relaxed">
            We work as both principal contractor and subcontractor. Civil contractors and developers can engage us directly. We manage the shutdown and tie-in with the distributor-retailer, attend all hold points, and deliver the full as-constructed documentation package for infrastructure agreement submission.
          </p>
        </div>

        <div class="space-y-4">
          {[
            { title: 'New water main installation', desc: 'Reticulation mains for residential and commercial subdivisions. Hydrants, gate valves, air valves and pressure reducing valves included.' },
            { title: 'Service connections to property boundaries', desc: 'Individual property connections from the water main to the property boundary. Road opening permits, traffic control and reinstatement managed.' },
            { title: 'Live connections & tie-ins', desc: 'Live connections to the existing council mains network. Shutdown coordination with QUU, Logan Water and Gold Coast Water.' },
            { title: 'Pressure testing & disinfection', desc: 'Pressure testing, disinfection, flushing and bacteriological sampling completed before any main is commissioned.' },
            { title: 'As-constructed documentation', desc: 'Full documentation for infrastructure agreement submission — GPS as-constructeds, pressure test certificates and clearance records.' },
          ].map(item => (
            <div class="bg-white border border-slate-200 rounded-xl p-5">
              <h3 class="font-semibold text-[#000000] text-sm mb-1">{item.title}</h3>
              <p class="text-[#1a1a1a] text-xs leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 bg-white" aria-labelledby="process-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 id="process-heading" class="text-3xl sm:text-4xl font-bold text-[#000000] mb-4">How we deliver a water main project</h2>
        <p class="text-[#1a1a1a] text-lg">From design submission to handover — straightforward, documented at every step.</p>
      </div>
      <div class="space-y-4">
        {PROCESS_STEPS.map(step => (
          <div class="bg-[#F0F5FA] border border-slate-200 rounded-2xl p-7 flex gap-6 items-start">
            <div class="text-4xl font-black text-[#0172ae]/20 leading-none flex-shrink-0 w-12 text-center">{step.step}</div>
            <div>
              <h3 class="font-bold text-[#000000] text-lg mb-2">{step.title}</h3>
              <p class="text-[#1a1a1a] text-sm leading-relaxed">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-20 bg-[#F0F5FA]" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="faq-heading" class="text-3xl font-bold text-[#000000] mb-10">Frequently asked questions</h2>
      <div class="space-y-4">
        {FAQS.map(faq => (
          <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none font-semibold text-[#000000] hover:text-[#0172ae] transition-colors">
              {faq.q}
              <svg class="w-4 h-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-6 text-[#1a1a1a] text-sm leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CivilEnquiryForm formId={FORM_ID} initialProjectType="water-mains" client:visible slot="enquiry-form" />

  <VideoHero
    slot="hero"
    videoSrc="/videos/civil-excavator-wide.mp4"
    headline="Water Main Installation — South-East Queensland"
    subheadline="New water main installation, service connections and live tie-ins for residential subdivisions, commercial developments and councils across Brisbane, Logan, Gold Coast and Ipswich."
    ctaText="Submit an RFQ"
    ctaHref="/civil/contact"
  />

</CivilLayout>
