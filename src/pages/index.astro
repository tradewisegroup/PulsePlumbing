<script>
  const form    = document.getElementById('lead-magnet-form')    as HTMLFormElement | null;
  const success = document.getElementById('lead-magnet-success') as HTMLElement | null;
  const error   = document.getElementById('lead-magnet-error')   as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value?.trim();
    if (!email) return;

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          full_name:    'Lead Magnet Subscriber',
          email,
          phone:        '',
          message:      'Requested: SEQ Property Manager\'s Plumbing Compliance Checklist',
          source:       'Homepage Lead Magnet',
          page_source:  'Homepage',
          tag:          'lead-magnet-checklist',
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success !== false) {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      } else {
        throw new Error(data.error ?? 'Submission failed');
      }
    } catch {
      error?.classList.remove('hidden');
      if (btn) { btn.disabled = false; btn.textContent = 'Send Me the Checklist'; }
    }
  });
</script>
