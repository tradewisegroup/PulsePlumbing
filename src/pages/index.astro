---
import BaseLayout from '../layouts/BaseLayout.astro';

const title       = "SEQ's Most Responsive Plumbing, Gas & Civil Contractor | Pulse";
const description = 'Trusted 24/7 on-call plumber and civil contractor in Brisbane and across South-East Queensland. Residential, commercial, and civil infrastructure — no surprises, no shortcuts. Call 0452 188 420.';

const services = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/></svg>`,
    label: 'InSinkErator Installation', href: '/services/insinkerator', desc: 'Licensed installation, replacement and repair of food waste disposers.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="3" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="21"/><line x1="3" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="21" y2="12"/><line x1="10.5" y1="10.5" x2="13.5" y2="13.5"/><line x1="13.5" y1="10.5" x2="10.5" y2="13.5"/></svg>`,
    label: 'Blocked Drains', href: '/services/blocked-drains', desc: 'CCTV inspection, high-pressure jetting and excavation.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="5" width="10" height="13" rx="2"/><path d="M10 5V3M14 5V3"/><path d="M10 18v3M14 18v3"/><path d="M9.5 11.5a2.5 2.5 0 0 0 5 0"/><line x1="12" y1="9" x2="12" y2="11.5"/></svg>`,
    label: 'Hot Water Systems', href: '/services/hot-water-systems', desc: 'Repairs, replacements and heat pump installs.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c-2 3-4 5.5-4 8a4 4 0 0 0 8 0c0-2.5-1.5-4-2-5.5 0 2-1.5 3.5-2 3.5s-2-1.5-2-3.5"/><line x1="5" y1="18" x2="19" y2="18"/><line x1="8" y1="15" x2="8" y2="18"/><line x1="12" y1="15" x2="12" y2="18"/><line x1="16" y1="15" x2="16" y2="18"/><line x1="3" y1="21" x2="21" y2="21"/></svg>`,
    label: 'Gas Fitting', href: '/services/gas-fitting', desc: 'Gas lines, appliance installs and safety checks.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="8" width="13" height="8" rx="2"/><circle cx="7.5" cy="12" r="2.5"/><path d="M14 10.5l5.5-3.5v10L14 13.5"/><circle cx="4.5" cy="12" r="0.5" fill="currentColor" stroke="none"/></svg>`,
    label: 'Drain Camera', href: '/services/drain-camera', desc: 'CCTV drain inspection and full condition reports.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10h7v4H2z"/><path d="M15 10h7v4h-7z"/><path d="M9 10l6 2-6 2z"/><line x1="15" y1="10" x2="15" y2="14"/></svg>`,
    label: 'Backflow Prevention', href: '/services/backflow-prevention', desc: 'Testing, certification and compliance repairs.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    label: 'Preventative Maintenance', href: '/services/preventative-maintenance', desc: 'Scheduled maintenance plans for commercial clients.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l2-8h14l2 8H3z"/><path d="M7 17v2a1 1 0 001 1h8a1 1 0 001-1v-2"/><path d="M5 9V7a2 2 0 012-2h10a2 2 0 012 2v2"/><rect x="9" y="11" width="6" height="3" rx="1"/><path d="M12 14v3"/></svg>`,
    label: 'Civil Works', href: '/civil', desc: 'Sewer construction, water mains, stormwater drainage and infrastructure maintenance.',
  },
];

const industries = [
  { label: 'Retail', href: '/industries/retail' },
  { label: 'Childcare', href: '/industries/childcare' },
  { label: 'Education', href: '/industries/education' },
  { label: 'Aged Care', href: '/industries/aged-care' },
  { label: 'Student Accommodation', href: '/industries/student-accommodation' },
  { label: 'Commercial Real Estate', href: '/industries/commercial-real-estate' },
  { label: 'Property Management', href: '/industries/property-management' },
  { label: 'New Builds', href: '/industries/new-builds' },
  { label: 'Civil', href: '/industries/civil' },
];

const locations = [
  { label: 'Brisbane', href: '/plumber-brisbane' },
  { label: 'Logan',    href: '/plumber-logan' },
  { label: 'Gold Coast', href: '/plumber-gold-coast' },
  { label: 'Ipswich', href: '/plumber-ipswich' },
];

const homepageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Pulse Plumbing, Gas & Civil',
  url: 'https://pulseqld.com.au',
};

const socialProofItems = [
  '4.9★ Google Rating',
  '130+ Suburbs Served',
  'QBCC Licensed',
  '24/7 Response',
  'Residential & Civil',
];

const triageCards = [
  {
    heading: 'Emergency Plumbing',
    body: 'Burst pipes, blocked drains, gas leaks. We\'re on call 24/7.',
    cta: 'Call Now',
    href: 'tel:0452188420',
    accent: '#f19329',
    dark: false,
  },
  {
    heading: 'Commercial & Strata',
    body: 'Maintenance contracts, compliance certificates, priority response.',
    cta: 'Get a Quote',
    href: '/contact',
    accent: '#0172ae',
    dark: false,
  },
  {
    heading: 'Civil Infrastructure',
    body: 'Sewer construction, water mains, stormwater. RFQ within 1 business day.',
    cta: 'Submit RFQ',
    href: '/civil/contact',
    accent: '#10a2d5',
    dark: true,
  },
];
---

<BaseLayout {title} {description} schema={homepageSchema}>

  <!-- ── Hero — full-screen dark, matching civil page style ── -->
  <section class="relative overflow-hidden bg-[#000000]" style="min-height: 560px;">

    <!-- Background image with dark overlay -->
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/images/van-hero.jpg"
        alt=""
        class="absolute inset-0 w-full h-full object-cover opacity-40"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-black/30"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28 lg:py-40 flex items-center">
      <div class="max-w-2xl">

        <!-- Tag -->
        <p class="text-xs font-bold uppercase tracking-widest text-[#10a2d5] mb-5">
          QBCC Licensed · Residential · Commercial · Civil · SE Queensland
        </p>

        <!-- H1 -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          SEQ's Most Responsive Plumbing, Gas &amp; Civil Contractor
        </h1>

        <!-- Subtitle -->
        <p class="text-lg text-white/70 leading-relaxed mb-10 max-w-xl">
          Trusted 24/7 on-call plumber and civil contractor in Brisbane and across South-East Queensland. Residential, commercial, and civil infrastructure — no surprises, no shortcuts.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a href="tel:0452188420"
             class="inline-flex items-center justify-center gap-2 bg-[#f19329] hover:bg-[#d97d1a] text-white font-bold px-8 py-4 rounded-full text-base transition-colors shadow-lg shadow-[#f19329]/30">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Call Now — Emergency
          </a>
          <a href="/contact"
             class="inline-flex items-center justify-center bg-[#0172ae] hover:bg-[#015d8e] text-white font-semibold px-8 py-4 rounded-full text-base transition-colors shadow-lg shadow-[#0172ae]/25">
            Get a Free Quote
            </a>
          </div>

          <!-- Trust badges -->
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/50">
            {['QBCC Licensed', 'Fully Insured', 'Residential & Civil', 'SE Queensland'].map((t) => (
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#10a2d5] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                {t}
              </span>
            ))}
          </div>

      </div>
    </div>
  </section>

  <!-- ── Social proof bar ── -->
  <div class="bg-white border-b border-[#D1D5DB]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 overflow-x-auto">
      <div class="flex items-center gap-0 min-w-max sm:min-w-0 sm:justify-center">
        {socialProofItems.map((item, i) => (
          <>
            <span class="text-sm font-semibold text-[#1a1a1a] whitespace-nowrap px-4">{item}</span>
            {i < socialProofItems.length - 1 && (
              <span class="text-[#D1D5DB] select-none">·</span>
            )}
          </>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Three-Path Triage ── -->
  <section class="py-10 bg-[#F0F5FA]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-3 gap-4">
        {triageCards.map((card) => (
          <div class={`rounded-2xl p-6 flex flex-col ${card.dark ? 'bg-[#000000] text-white' : 'bg-white border border-[#D1D5DB] text-[#000000]'}`}>
            <div class="flex-1">
              <div class="w-2 h-6 rounded-full mb-4" style={`background-color: ${card.accent}`}></div>
              <h3 class={`text-lg font-bold mb-2 ${card.dark ? 'text-white' : 'text-[#000000]'}`}>{card.heading}</h3>
              <p class={`text-sm leading-relaxed mb-6 ${card.dark ? 'text-white/60' : 'text-[#1a1a1a]/60'}`}>{card.body}</p>
            </div>
            <a
              href={card.href}
              class="inline-flex items-center justify-center gap-2 font-bold text-sm px-5 py-2.5 rounded-full transition-colors text-white"
              style={`background-color: ${card.accent}`}
            >
              {card.cta}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Services grid ── -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-[#000000] mb-4">Our Services</h2>
        <p class="text-lg text-[#1a1a1a]/60 max-w-2xl mx-auto">
          From emergency callouts to scheduled commercial maintenance — we handle it all.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {services.map((s) => (
          <a href={s.href}
             class="group flex flex-col items-center text-center bg-white border border-[#D1D5DB] hover:border-[#0172ae] rounded-xl p-7 transition-all hover:shadow-md">
            <div class="w-10 h-10 text-[#0172ae] mb-4 group-hover:text-[#015d8e] transition-colors" set:html={s.icon}></div>
            <h3 class="font-semibold text-[#000000] group-hover:text-[#0172ae] mb-2 transition-colors">{s.label}</h3>
            <p class="text-sm text-[#1a1a1a]/60 leading-relaxed">{s.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why Pulse ── -->
  <section class="py-20 bg-[#F0F5FA]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-start">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-[#000000] mb-8">
            Why South-East Queensland chooses Pulse
          </h2>
          <div class="space-y-6">
            {[
              {
                title: '24/7 emergency response',
                desc: 'We answer the phone at 2am and we show up. Nights, weekends and public holidays — no excuses.',
              },
              {
                title: 'Transparent, upfront quoting',
                desc: 'You get a clear price before we start. No hidden call-out fees, no surprise charges on the invoice.',
              },
              {
                title: 'Residential, commercial & civil',
                desc: 'From a dripping tap to civil water main installation. Same team, same standards.',
              },
              {
                title: 'QBCC licensed & fully insured',
                desc: 'All work is completed by licensed tradespeople and backed by a workmanship warranty.',
              },
            ].map((item) => (
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-[#0172ae] flex items-center justify-center mt-0.5">
                  <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-[#000000] mb-1">{item.title}</h3>
                  <p class="text-sm text-[#1a1a1a]/60 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Industries panel -->
        <div class="bg-white border border-[#D1D5DB] rounded-xl p-8 shadow-sm">
          <h3 class="font-semibold text-[#000000] text-lg mb-5">Industries we serve</h3>
          <div class="flex flex-wrap gap-2">
            {industries.map((i) => (
              <a href={i.href}
                 class="bg-[#F0F5FA] hover:bg-[#0172ae] border border-[#D1D5DB] hover:border-[#0172ae] text-sm text-[#1a1a1a] hover:text-white px-3 py-1.5 rounded-full transition-colors">
                {i.label}
              </a>
            ))}
          </div>
          <p class="mt-6 text-sm text-[#1a1a1a]/60">
            We build long-term maintenance relationships with commercial clients across all sectors.
          </p>
          <a href="/contact"
             class="mt-5 inline-block bg-[#0172ae] hover:bg-[#015d8e] text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors">
            Discuss a Maintenance Contract
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Lead magnet ── -->
  <section class="py-16 bg-[#F0F5FA] border-t border-[#D1D5DB]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-[#0172ae]/10 border border-[#0172ae]/20 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[#0172ae] mb-5">
          Free Download
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#000000] mb-3">
          SEQ Property Manager's Plumbing Compliance Checklist
        </h2>
        <p class="text-[#1a1a1a]/60 mb-8 leading-relaxed">
          Know exactly what compliance certificates your property needs under Queensland law.
        </p>

        <form id="lead-magnet-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input
            type="email"
            name="email"
            required
            placeholder="your@email.com.au"
            class="flex-1 border border-[#D1D5DB] rounded-full px-5 py-3 text-sm text-[#1a1a1a] focus:outline-none focus:ring-2 focus:ring-[#0172ae] focus:border-transparent bg-white"
          />
          <button
            type="submit"
            class="flex-shrink-0 bg-[#0172ae] hover:bg-[#015d8e] text-white font-semibold text-sm px-6 py-3 rounded-full transition-colors"
          >
            Send Me the Checklist
          </button>
        </form>

        <div id="lead-magnet-success" class="hidden mt-4 text-sm font-semibold text-green-700 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
          Check your inbox — your checklist is on its way.
        </div>
        <div id="lead-magnet-error" class="hidden mt-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-5 py-3">
          Something went wrong. Please try again or call 0452 188 420.
        </div>

        <p class="mt-4 text-xs text-[#1a1a1a]/40">No spam. Unsubscribe any time.</p>
      </div>
    </div>
  </section>

  <!-- ── Locations ── -->
  <section class="py-16 bg-white border-t border-[#D1D5DB]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-[#000000] mb-3">Servicing South-East Queensland</h2>
      <p class="text-[#1a1a1a]/60 mb-8">Based in Ormeau — covering the full South-East corridor.</p>
      <div class="flex flex-wrap justify-center gap-4">
        {locations.map((l) => (
          <a href={l.href}
             class="bg-[#F0F5FA] hover:bg-[#0172ae] border border-[#D1D5DB] hover:border-[#0172ae] text-[#1a1a1a] hover:text-white font-medium px-6 py-3 rounded-full transition-colors">
            📍 Plumber {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Productised Offer — Pulse 360 ── -->
  <section class="py-20 bg-[#000000] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-widest text-[#10a2d5] mb-4">Maintenance Plans</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          The Pulse 360° Maintenance Plan
        </h2>
        <p class="text-white/60 text-lg mb-10 leading-relaxed">
          One fixed monthly fee. All compliance certificates. Priority 2-hour response. Dedicated account manager.
        </p>

        <div class="grid sm:grid-cols-3 gap-5 mb-10">
          {[
            { month: 'Month 1', point: 'Full plumbing audit and compliance baseline' },
            { month: 'Month 3', point: 'All certificates current, zero outstanding issues' },
            { month: 'Month 12', point: 'Predictable costs, zero emergency callouts' },
          ].map((item) => (
            <div class="bg-white/5 border border-white/10 rounded-xl p-5">
              <p class="text-xs font-bold uppercase tracking-widest text-[#10a2d5] mb-2">{item.month}</p>
              <p class="text-sm text-white/80 leading-relaxed">{item.point}</p>
            </div>
          ))}
        </div>

        <a href="/contact"
           class="inline-flex items-center gap-2 bg-[#0172ae] hover:bg-[#015d8e] text-white font-semibold px-8 py-3.5 rounded-full transition-colors shadow-lg shadow-[#0172ae]/25">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
          </svg>
          Discuss a Maintenance Plan
        </a>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="bg-[#0172ae] py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Need a plumber now?</h2>
      <p class="text-xl text-blue-100 mb-8">
        Available afterhours and on weekends. Call us for emergency assistance.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <div class="flex flex-col gap-2">
          <a href="tel:0452188420"
             class="inline-flex items-center justify-center gap-2 bg-[#f19329] hover:bg-[#d97d1a] text-white font-bold px-8 py-4 rounded-full text-base transition-colors shadow-lg shadow-black/20">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Call 0452 188 420
          </a>
          <span class="text-xs text-blue-100/70 text-center">24/7 Emergency</span>
        </div>
        <div class="flex flex-col gap-2">
          <a href="tel:0721504175"
             class="inline-flex items-center justify-center gap-2 bg-white hover:bg-blue-50 text-[#0172ae] font-bold px-8 py-4 rounded-full text-base transition-colors border border-white">
