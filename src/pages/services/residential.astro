---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
---

<ServiceLayout
  serviceName="Residential Plumbing"
  serviceSlug="residential"
  heroTitle="Residential Plumbing Services Across Brisbane, Logan & Gold Coast"
  heroSubtitle="Fast, reliable plumbing for houses, units, townhouses and apartments — including maintenance, repairs, hot water, blocked drains and bathroom renovations across South-East Queensland."
  heroImage="/images/residential-bathroom.png"
  keyBenefits={[
    '24/7 emergency response for burst pipes, gas leaks and major leaks',
    'Upfront pricing — you approve the cost before we start any work',
    'Tidy workmanship — we respect your home and clean up before we leave',
    'QBCC licensed and fully insured for your peace of mind',
  ]}
  process={[
    {
      title: 'Book your appointment',
      description: 'Call us on 0452 188 420 or submit an online request. We confirm a time that suits you — same day for urgent issues, next available for routine work.',
    },
    {
      title: 'Diagnose and quote',
      description: 'We inspect the issue, explain what needs to be done and provide a clear, written quote before any work begins. No surprises.',
    },
    {
      title: 'Complete the job',
      description: 'Work is carried out by a QBCC-licensed plumber using quality materials. We work efficiently to minimise disruption to your household.',
    },
    {
      title: 'Clean up and certify',
      description: 'We leave your home tidy and provide a Certificate of Compliance for any notifiable work. A job report is available on request.',
    },
  ]}
  faqs={[
    {
      q: 'What residential plumbing services do you offer?',
      a: 'We cover the full range of residential plumbing: blocked drains, leaking taps and toilets, hot water system repairs and replacements, burst pipes, bathroom and kitchen renovations, gas fitting, water pressure issues, toilet replacements, InSinkErator food waste disposer installation and repair, and general maintenance.',
    },
    {
      q: 'Do you offer after-hours plumbing for residential emergencies?',
      a: 'Yes — we provide 24/7 emergency plumbing for residential properties. Burst pipes, gas leaks, sewage overflows and failure of hot water systems are all handled as emergency call-outs, day or night.',
    },
    {
      q: 'How much does a residential plumber cost?',
      a: 'We provide a fixed price before starting any work so there are no surprises. Pricing depends on the scope of work. We do not charge additional call-out fees for emergency calls outside business hours. Contact us for a quote specific to your job.',
    },
    {
      q: 'Can you help with a bathroom or laundry renovation?',
      a: 'Yes. We handle all rough-in and fit-off plumbing for bathroom, kitchen, laundry and ensuite renovations — including waste connections, water supply, shower and bath installations, and connecting new fixtures and appliances.',
    },
    {
      q: 'Do you work on rental properties?',
      a: 'Yes. We regularly work with property managers and tenants to resolve maintenance issues at rental properties. We attend directly, report back to the property manager with photos and a job description, and invoice the managing agency.',
    },
    {
      q: 'What areas of South-East QLD do you cover for residential plumbing?',
      a: 'We service homes across Logan City, Brisbane (south), Redland City, Gold Coast (north) and Ipswich — more than 130 suburbs within 30 km of Loganholme.',
    },
  ]}
  relatedIndustries={[
    'property-management',
    'new-builds',
    'student-accommodation',
  ]}
  metaTitle="Residential Plumber Brisbane, Logan & Gold Coast QLD"
  metaDescription="Trusted residential plumbing for homes and units across Brisbane, Logan, Gold Coast and Ipswich. 24/7 emergencies, upfront pricing, QBCC licensed. Call 0452 188 420."
  
/>
