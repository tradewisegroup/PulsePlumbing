---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'All Services | Pulse Plumbing & Gas';
const description = 'Explore all plumbing and gas services offered by Pulse Plumbing & Gas across Brisbane, Logan, Gold Coast and Ipswich — available 24/7 including afterhours and weekends.';

const services = [
  {
    image: '/images/maintenance-hero.png',
    label: 'Maintenance Plumbing',
    desc: 'Scheduled and reactive maintenance for residential and commercial properties. Preventative plans available for strata, facilities and property managers.',
    href: '/services/preventative-maintenance',
  },
  {
    image: '/images/commercial-property.png',
    label: 'Commercial',
    desc: 'Full-service commercial plumbing for facilities, strata complexes, retail fit-outs and building managers across South-East Queensland.',
    href: '/industries',
  },
  {
    image: '/images/residential-property.png',
    label: 'Residential',
    desc: 'Trusted plumbing for homes, units and townhouses. From leaking taps to full bathroom renovations — reliable service every time.',
    href: '/services/residential',
  },
  {
    image: '/images/gas-fitting-hero.png',
    label: 'Gas Fitting',
    desc: 'Licensed gas fitting for new lines, appliance connections and safety checks. Residential and commercial gas work across SE Queensland.',
    href: '/services/gas-fitting',
  },
  {
    image: '/images/blocked-drains-hero.png',
    label: 'Blocked Drains',
    desc: 'High-pressure water jetting, CCTV inspection and root cutting. Fast response for blocked drains in homes and commercial properties.',
    href: '/services/blocked-drains',
  },
  {
    image: '/images/insinkerator-hero.png',
    label: 'InSinkErator Installation',
    desc: 'Licensed installation, replacement and repair of InSinkErator food waste disposers. Same-day service across Brisbane, Logan and Gold Coast.',
    href: '/services/insinkerator',
  },
  {
    image: '/images/hot-water-hero.png',
    label: 'Hot Water',
    desc: 'Repairs, replacements and heat pump installations. All brands, all systems — electric, gas, solar and heat pump.',
    href: '/services/hot-water-systems',
  },
  {
    image: '/images/cctv-drain-hero.png',
    label: 'CCTV Drain Camera',
    desc: 'Detailed CCTV inspection reports with video footage. Identify blockages, root intrusion, pipe damage and root cause without digging.',
    href: '/services/drain-camera',
  },
  {
    image: '/images/rpz-valve.png',
    label: 'Backflow Prevention',
    desc: 'QBCC-compliant testing, certification and repairs. Annual backflow prevention testing for commercial and industrial properties.',
    href: '/services/backflow-prevention',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Plumbing & Gas Services — Pulse Plumbing & Gas',
  url: 'https://pulseqld.com.au/services',
  description,
};
---

<BaseLayout {title} {description} canonical="https://pulseqld.com.au/services" schema={schema}>

  <!-- Hero -->
  <section class="bg-[#000000] py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 text-xs text-white/50" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-white/80 transition-colors">Home</a></li>
          <li class="text-white/30">/</li>
          <li class="text-white/70">Services</li>
        </ol>
      </nav>
      <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight mb-4">
        Our Services
      </h1>
      <p class="text-lg text-white max-w-2xl mt-4">
        From emergency callouts to scheduled commercial maintenance — Pulse Plumbing &amp; Gas handles it all across Brisbane, Logan, Gold Coast and Ipswich. Available 24/7.
      </p>
    </div>
  </section>

  <!-- Services grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s) => (
          <a href={s.href}
             class="group relative flex flex-col overflow-hidden rounded-xl hover:shadow-xl transition-all duration-300 min-h-[260px]">
            <img
              src={s.image}
              alt={s.label}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {/* Solid dark band at the bottom where text lives */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            {/* Hover brightener */}
            <div class="absolute inset-0 bg-[#0172ae]/0 group-hover:bg-[#0172ae]/10 transition-colors duration-300"></div>
            <div class="relative mt-auto px-4 py-4 flex items-center justify-between gap-3">
              <h2 class="font-bold text-[#10a2d5] text-base leading-tight drop-shadow">{s.label}</h2>
              <span class="shrink-0 inline-flex items-center gap-1.5 bg-[#f19329] group-hover:bg-[#d97d1a] text-white text-xs font-bold px-3.5 py-1.5 rounded-full transition-colors">
                Learn more
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0172ae] py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Need a plumber now?</h2>
      <p class="text-blue-100 mb-8">Available 24/7 including afterhours and weekends across South-East Queensland.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:0452188420"
           class="inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold px-8 py-4 rounded text-lg transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.773-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
          Call Now — Emergency Response
        </a>
        <a href="/contact"
           class="inline-flex items-center justify-center bg-white hover:bg-gray-50 text-[#046bd2] font-semibold px-8 py-4 rounded text-lg transition-colors">
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
