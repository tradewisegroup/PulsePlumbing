---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Industries We Serve | Pulse Plumbing, Gas & Civil';
const description = 'Commercial plumbing, gas and civil services for retail, childcare, education, aged care, strata and property management across Brisbane, Logan, Gold Coast and Ipswich.';
const canonical   = 'https://pulseqld.com.au/industries';

const industries = [
  {
    label: 'Retail',
    desc: 'Plumbing maintenance, fit-out connections and compliance for retail tenancies and shopping centres.',
    href: '/industries/retail',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>`,
  },
  {
    label: 'Childcare',
    desc: 'Thermostatic mixing valve servicing, compliance certificates and maintenance for childcare facilities.',
    href: '/industries/childcare',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  },
  {
    label: 'Education',
    desc: 'Scheduled maintenance, backflow testing and compliance for schools and universities.',
    href: '/industries/education',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>`,
  },
  {
    label: 'Aged Care',
    desc: 'TMV servicing, backflow prevention and full compliance programmes for aged care facilities.',
    href: '/industries/aged-care',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
  },
  {
    label: 'Accommodation',
    desc: 'Plumbing maintenance and rapid response for hotels, student accommodation and serviced apartments.',
    href: '/industries/student-accommodation',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    label: 'Commercial Real Estate',
    desc: 'Maintenance programmes and compliance for commercial buildings, office towers and mixed-use developments.',
    href: '/industries/commercial-real-estate',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>`,
  },
  {
    label: 'Property Management',
    desc: 'Priority response and scheduled maintenance for property managers across South-East Queensland.',
    href: '/industries/property-management',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  },
  {
    label: 'New Builds',
    desc: 'Rough-in, fit-off and connection to services for residential and commercial new construction.',
    href: '/industries/new-builds',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>`,
  },
];
---

<BaseLayout {title} {description} {canonical}>

  <!-- Hero -->
  <section class="bg-[#000000] py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 text-xs text-white/50" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-white/80 transition-colors">Home</a></li>
          <li class="text-white/30">/</li>
          <li class="text-white/70">Industries</li>
        </ol>
      </nav>
      <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight mb-4">
        Industries We Serve
      </h1>
      <p class="text-lg text-white/60 max-w-2xl mt-4">
        Commercial plumbing, gas and civil services for a wide range of industries across Brisbane, Logan, Gold Coast and Ipswich — available 24/7.
      </p>
    </div>
  </section>

  <!-- Industries grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map((ind) => (
          <a href={ind.href}
             class="group flex flex-col bg-white border border-[#D1D5DB] hover:border-[#0172ae] rounded-xl p-7 transition-all hover:shadow-md">
            <div class="w-10 h-10 text-[#0172ae] mb-4 group-hover:text-[#015d8e] transition-colors" set:html={ind.icon}></div>
            <h2 class="font-semibold text-[#000000] group-hover:text-[#0172ae] mb-2 transition-colors text-lg">{ind.label}</h2>
            <p class="text-sm text-[#1a1a1a]/60 leading-relaxed flex-1">{ind.desc}</p>
            <span class="mt-4 text-xs font-semibold text-[#0172ae] group-hover:text-[#015d8e] transition-colors">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0172ae] py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Don't see your industry?</h2>
      <p class="text-blue-100 mb-8">We work across all commercial sectors. Get in touch to discuss your specific requirements.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:0721504175"
           class="inline-flex items-center justify-center gap-2 bg-white text-[#0172ae] font-bold px-8 py-4 rounded-full text-base transition-colors hover:bg-blue-50">
          Call Office — 07 2150 4175
        </a>
        <a href="/contact"
           class="inline-flex items-center justify-center bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-8 py-4 rounded-full text-base transition-colors">
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
