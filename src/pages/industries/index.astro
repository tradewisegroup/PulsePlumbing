---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title       = 'Industries We Serve | Pulse Plumbing, Gas & Civil';
const description = 'Commercial plumbing, gas and civil services for retail, childcare, education, aged care, strata and property management across Brisbane, Logan, Gold Coast and Ipswich.';
const canonical   = 'https://pulseqld.com.au/industries';

const industries = [
  { image: '/images/industry-retail.png',                label: 'Retail',                desc: 'Plumbing maintenance, fit-out connections and compliance for retail tenancies and shopping centres.',          href: '/industries/retail'                },
  { image: '/images/industry-childcare.png',             label: 'Childcare',             desc: 'Thermostatic mixing valve servicing, compliance certificates and maintenance for childcare facilities.',        href: '/industries/childcare'             },
  { image: '/images/industry-education.png',             label: 'Education',             desc: 'Scheduled maintenance, backflow testing and compliance for schools and universities.',                          href: '/industries/education'             },
  { image: '/images/industry-aged-care.png',             label: 'Aged Care',             desc: 'TMV servicing, backflow prevention and full compliance programmes for aged care facilities.',                   href: '/industries/aged-care'             },
  { image: '/images/industry-accommodation.png',         label: 'Accommodation',         desc: 'Plumbing maintenance and rapid response for hotels, student accommodation and serviced apartments.',           href: '/industries/student-accommodation' },
  { image: '/images/industry-commercial-real-estate.png',label: 'Commercial Real Estate',desc: 'Maintenance programmes and compliance for commercial buildings, office towers and mixed-use developments.',     href: '/industries/commercial-real-estate'},
  { image: '/images/industry-property-management.png',   label: 'Property Management',   desc: 'Priority response and scheduled maintenance for property managers across South-East Queensland.',             href: '/industries/property-management'   },
  { image: '/images/industry-new-builds.png',            label: 'New Builds',            desc: 'Rough-in, fit-off and connection to services for residential and commercial new construction.',                href: '/industries/new-builds'            },
  { image: '/images/industry-hospitality.png',           label: 'Hospitality',           desc: 'Commercial kitchen gas fitting, grease trap maintenance and bar fitout for restaurants, cafes and pubs.',     href: '/industries/hospitality'           },
];
---

<BaseLayout {title} {description} {canonical}>

  <!-- Hero -->
  <section class="bg-[#000000] py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 text-xs text-white/50" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-white/80 transition-colors">Home</a></li>
          <li class="text-white/30">/</li>
          <li class="text-white/70">Industries</li>
        </ol>
      </nav>
      <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight mb-4">
        Industries We Serve
      </h1>
      <p class="text-lg text-white max-w-2xl mt-4">
        Commercial plumbing, gas and civil services for a wide range of industries across Brisbane, Logan, Gold Coast and Ipswich — available 24/7.
      </p>
    </div>
  </section>

  <!-- Industries grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map((ind) => (
          <a href={ind.href}
             class="group relative flex flex-col overflow-hidden rounded-xl hover:shadow-xl transition-all duration-300 min-h-[260px]">
            <img
              src={ind.image}
              alt={ind.label}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-black/20"></div>
            <div class="absolute inset-0 bg-[#0172ae]/0 group-hover:bg-[#0172ae]/15 transition-colors duration-300"></div>
            <div class="relative mt-auto p-5 text-left">
              <h2 class="font-bold text-[#10a2d5] text-lg mb-1.5 drop-shadow">{ind.label}</h2>
              <p class="text-sm text-white/90 leading-relaxed mb-3">{ind.desc}</p>
              <span class="inline-flex items-center gap-1.5 bg-[#f19329] group-hover:bg-[#d97d1a] text-white text-xs font-bold px-3.5 py-1.5 rounded-full transition-colors">
                Learn more
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0172ae] py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Don't see your industry?</h2>
      <p class="text-blue-100 mb-8">We work across all commercial sectors. Get in touch to discuss your specific requirements.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:0721504175"
           class="inline-flex items-center justify-center gap-2 bg-white text-[#0172ae] font-bold px-8 py-4 rounded-full text-base transition-colors hover:bg-blue-50">
          Call Office — 07 2150 4175
        </a>
        <a href="/contact"
           class="inline-flex items-center justify-center bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-8 py-4 rounded-full text-base transition-colors">
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
