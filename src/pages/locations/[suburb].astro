---
/**
 * /locations/[suburb] — suburb-targeted plumbing service pages.
 *
 * Generates one static page per entry in src/data/suburbs.json.
 * URL: /locations/loganholme, /locations/springwood, etc.
 *
 * Schema: LocalBusiness (geo from suburbs.json) + FAQPage
 * Form:   QuoteForm island (pre-fills suburb field)
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm  from '../../components/forms/QuoteForm.jsx';
import suburbsData from '../../data/suburbs.json';

// ─── Types ────────────────────────────────────────────────────────────────────

interface SuburbEntry {
  name:             string;
  slug:             string;
  region:           string;
  postcode:         string;
  lat:              number;
  lng:              number;
  population_size:  'small' | 'medium' | 'large';
  nearby_suburbs:   string[];
}

// ─── Static paths ─────────────────────────────────────────────────────────────

export async function getStaticPaths() {
  const suburbs = suburbsData as SuburbEntry[];
  return suburbs.map((suburb) => ({
    params: { suburb: suburb.slug },
    props:  { suburb },
  }));
}

// ─── Props ────────────────────────────────────────────────────────────────────

const { suburb } = Astro.props as { suburb: SuburbEntry };

// Build a slug → name lookup for nearby suburb links
const slugToName = new Map(
  (suburbsData as SuburbEntry[]).map((s) => [s.slug, s.name])
);

const nearbyDetails = suburb.nearby_suburbs
  .map((sl) => ({ slug: sl, name: slugToName.get(sl) ?? sl }))
  .filter((s) => s.slug !== suburb.slug); // guard against self-reference

// ─── Page copy ────────────────────────────────────────────────────────────────

const SITE  = 'https://pulseqld.com.au';
const PHONE = '0452 188 420';
const PHONE_HREF = 'tel:0452188420';

const pageTitle       = `Plumber ${suburb.name} ${suburb.postcode}`;
const metaDescription =
  `Need a licensed plumber in ${suburb.name}? Pulse Plumbing & Gas provides 24/7 residential and commercial plumbing across ${suburb.name} ${suburb.postcode}. Fast response, upfront pricing. Call ${PHONE}.`;
const canonical = `${SITE}/locations/${suburb.slug}`;

// ─── Services list ────────────────────────────────────────────────────────────

const SERVICES = [
  {
    icon: '🔧',
    title: 'Maintenance Plumbing',
    description: 'Scheduled and reactive maintenance for homes and commercial properties.',
    href: '/services/maintenance-plumbing',
  },
  {
    icon: '🚨',
    title: 'Emergency Plumbing',
    description: 'Burst pipes, water leaks, and plumbing failures — we respond around the clock.',
    href: '/services/blocked-drains',
  },
  {
    icon: '🚿',
    title: 'Blocked Drains',
    description: 'High-pressure jet blasting and drain camera inspection to clear blockages fast.',
    href: '/services/blocked-drains',
  },
  {
    icon: '🔥',
    title: 'Hot Water Systems',
    description: 'Supply, installation, and repair of gas, electric, and heat-pump hot water units.',
    href: '/services/hot-water-systems',
  },
  {
    icon: '🔩',
    title: 'Gas Fitting',
    description: 'Licensed gas appliance installation, repairs, and leak detection.',
    href: '/services/gas-fitting',
  },
  {
    icon: '📹',
    title: 'CCTV Drain Camera',
    description: 'Real-time drain inspection to locate cracks, root intrusion, and collapsed pipes.',
    href: '/services/drain-camera',
  },
  {
    icon: '🛡️',
    title: 'Backflow Prevention',
    description: 'Annual testing and certification of backflow prevention devices.',
    href: '/services/backflow-prevention',
  },
  {
    icon: '🏢',
    title: 'Commercial Plumbing',
    description: 'Fit-outs, plant room maintenance, and facilities management contracts.',
    href: '/services/commercial',
  },
];

// ─── FAQs (suburb-specific) ───────────────────────────────────────────────────

const FAQS = [
  {
    q: `How quickly can Pulse Plumbing reach ${suburb.name}?`,
    a: `We keep licensed plumbers based across SE Queensland, including the ${suburb.name} ${suburb.postcode} area. For standard bookings we typically arrive the same day or next morning. For plumbing emergencies in ${suburb.name} — burst pipes, flooding, or gas leaks — call us on ${PHONE} and we aim to be on site within the hour.`,
  },
  {
    q: `Do you offer 24-hour emergency plumbing in ${suburb.name}?`,
    a: `Yes. Pulse Plumbing & Gas provides 24/7 emergency plumbing across ${suburb.name} and all surrounding suburbs. Our afterhours line is staffed by a licensed plumber, not an answering service, so you get a real response any time of day or night. Call ${PHONE} for immediate assistance.`,
  },
  {
    q: `What plumbing services do you provide in ${suburb.name}, QLD?`,
    a: `We cover the full range of residential and commercial plumbing services in ${suburb.name}: blocked drain clearing, burst pipe repairs, hot water system installation and repair, gas fitting, CCTV drain camera inspection, backflow prevention testing, and scheduled maintenance contracts. We are QBCC-licensed and insured, with $20M public liability cover.`,
  },
  {
    q: `Are your plumbers licensed to work in ${suburb.name} and the ${suburb.postcode} postcode?`,
    a: `Absolutely. All our plumbers hold current QBCC (Queensland Building and Construction Commission) Contractor Licences and are fully insured. We regularly service properties throughout ${suburb.name} ${suburb.postcode} for both residential homeowners and commercial facility managers. Ask for our licence certificate and insurance certificates of currency at any time.`,
  },
  {
    q: `How much does a plumber cost in ${suburb.name}?`,
    a: `Pricing depends on the job, but we provide upfront quotes before starting any work — no surprises on the invoice. Standard callout and labour rates apply across ${suburb.name}, with afterhours rates disclosed clearly in advance. For a free, no-obligation quote for your ${suburb.name} property, use the form on this page or call ${PHONE}.`,
  },
];

// ─── Schema ───────────────────────────────────────────────────────────────────

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type':    ['LocalBusiness', 'Plumber'],
  '@id':      `${SITE}/#business`,
  name:       'Pulse Plumbing & Gas',
  url:        SITE,
  logo:       `${SITE}/images/logo-light.jpeg`,
  image:      `${SITE}/images/og-default.jpg`,
  telephone:  '0452188420',
  email:      'admin@pulseqld.com.au',
  description:
    `QBCC-licensed plumber servicing ${suburb.name} ${suburb.postcode}, QLD. Residential and commercial maintenance plumbing available 24/7.`,
  address: {
    '@type':          'PostalAddress',
    addressLocality:  suburb.name,
    addressRegion:    'QLD',
    postalCode:       suburb.postcode,
    addressCountry:   'AU',
  },
  geo: {
    '@type':    'GeoCoordinates',
    latitude:   suburb.lat,
    longitude:  suburb.lng,
  },
  areaServed: {
    '@type':    'City',
    name:       suburb.name,
    postalCode: suburb.postcode,
  },
  openingHoursSpecification: {
    '@type':     'OpeningHoursSpecification',
    dayOfWeek:   ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens:       '00:00',
    closes:      '23:59',
  },
  priceRange: '$$',
  hasCredential: {
    '@type':            'EducationalOccupationalCredential',
    credentialCategory: 'QBCC Contractor Licence — Plumbing and Drainage',
    recognizedBy: {
      '@type': 'GovernmentOrganization',
      name:    'Queensland Building and Construction Commission',
      url:     'https://www.qbcc.qld.gov.au',
    },
  },
  sameAs: [],
};

const serviceSchema = {
  '@context':   'https://schema.org',
  '@type':      'PlumbingService',
  '@id':        `${canonical}#service`,
  name:         `Plumber in ${suburb.name} — Pulse Plumbing & Gas`,
  description:  metaDescription,
  provider:     { '@type': 'Organization', '@id': `${SITE}/#business` },
  areaServed:   { '@type': 'City', name: suburb.name, postalCode: suburb.postcode },
  url:          canonical,
};

const breadcrumbSchema = {
  '@context':        'https://schema.org',
  '@type':           'BreadcrumbList',
  '@id':             `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',          item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: `${SITE}/service-areas` },
    { '@type': 'ListItem', position: 3, name: `Plumber ${suburb.name}`, item: canonical },
  ],
};

const faqSchema = {
  '@context':  'https://schema.org',
  '@type':     'FAQPage',
  '@id':       `${canonical}#faq`,
  mainEntity:  FAQS.map((f) => ({
    '@type':        'Question',
    name:           f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// BaseLayout accepts a single schema object; pass the most important one (LocalBusiness).
// Service, breadcrumb, and FAQ schemas are injected inline below.
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  canonical={canonical}
  schema={localBusinessSchema}
>

  <!-- ── Additional schema: Service + Breadcrumb + FAQ ──────────────────── -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)}    slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}        slot="head" />

  <!-- ══════════════════════════════════════════════════════════════════════════
       §1 HERO
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-[#000000] text-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-1.5 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/service-areas" class="hover:text-white transition-colors">Service Areas</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-300" aria-current="page">{suburb.name}</span>
      </nav>

      <div class="grid lg:grid-cols-[1fr_340px] gap-10 lg:gap-16 items-center">

        <!-- Left: headline + intro -->
        <div>
          <!-- Eyebrow -->
          <div class="flex items-center gap-2 mb-4" aria-hidden="true">
            <div class="w-1 h-5 bg-[#0172ae] rounded-full"></div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.15em]">
              {suburb.region === 'GoldCoast' ? 'Gold Coast' : suburb.region} · {suburb.postcode}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-5 inline-block bg-[#0172ae]/60 px-5 py-3 rounded-xl shadow-md">
            Plumber in {suburb.name}<br />
            <span class="text-blue-200">— Pulse Plumbing &amp; Gas</span>
          </h1>

          <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-6 max-w-xl">
            Pulse Plumbing &amp; Gas is your local QBCC-licensed plumber in <strong class="text-white">{suburb.name}</strong>.
            We cover the full {suburb.postcode} postcode for residential maintenance, commercial plumbing,
            emergency callouts, gas fitting, hot water, and drain services —
            24&hairsp;hours a day, 7 days a week.
          </p>

          <!-- Trust signals row -->
          <div class="flex flex-wrap gap-3 mb-8">
            {[
              'QBCC Licensed',
              '$20M Public Liability',
              '24/7 Available',
              'Same-Day Response',
            ].map((badge) => (
              <span class="inline-flex items-center gap-1.5 bg-white/8 border border-white/15 text-white text-xs font-semibold px-3 py-1.5 rounded-full">
                <svg class="w-3 h-3 text-[#0172ae] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {badge}
              </span>
            ))}
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-3">
            <a
              href={PHONE_HREF}
              class="inline-flex items-center gap-2 bg-[#0172ae] hover:bg-[#015d8e] text-white font-bold px-6 py-3.5 rounded-full transition-colors shadow-lg shadow-[#0172ae]/30 text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Call {PHONE}
            </a>
            <a
              href="#quote"
              class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-6 py-3.5 rounded-full transition-colors text-sm"
            >
              Get a Free Quote
            </a>
          </div>
        </div>

        <!-- Right: quick stats card -->
        <div class="bg-white/6 border border-white/12 rounded-2xl p-6 space-y-4">
          <h2 class="text-sm font-bold text-white mb-4">Service snapshot — {suburb.name}</h2>
          {[
            { label: 'Response time',    value: 'Same day / 1-hour emergency' },
            { label: 'Coverage',         value: `${suburb.name} ${suburb.postcode} + surrounds` },
            { label: 'Availability',     value: '24/7 including weekends' },
            { label: 'Licence',          value: 'QBCC Plumbing & Drainage' },
            { label: 'Public liability', value: '$20M' },
            { label: 'Workers comp',     value: 'WorkCover QLD' },
          ].map((row) => (
            <div class="flex items-start justify-between gap-4 text-xs border-b border-white/10 pb-3 last:border-0 last:pb-0">
              <span class="text-slate-400 shrink-0">{row.label}</span>
              <span class="text-white font-semibold text-right">{row.value}</span>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       §2 EMERGENCY CALLOUT
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-8" aria-label="Emergency plumbing callout">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-2 border-red-500 bg-red-50 rounded-2xl px-6 py-5 flex flex-col sm:flex-row items-start sm:items-center gap-5">

        <!-- Icon -->
        <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center flex-shrink-0" aria-hidden="true">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>

        <!-- Copy -->
        <div class="flex-1 min-w-0">
          <p class="font-bold text-red-800 text-base mb-0.5">
            Plumbing emergency in {suburb.name}?
          </p>
          <p class="text-red-700 text-sm leading-relaxed">
            Burst pipe, severe leak, blocked sewer, or gas smell — call us now.
            We cover <strong>{suburb.name} {suburb.postcode}</strong> 24&hairsp;hours a day,
            365 days a year.
          </p>
        </div>

        <!-- CTA -->
        <a
          href={PHONE_HREF}
          class="flex-shrink-0 inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold px-5 py-3 rounded-full text-sm transition-colors shadow shadow-red-600/25 whitespace-nowrap"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Call Now — Emergency Response
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       §3 SERVICES AVAILABLE IN THIS AREA
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-16 bg-[#F0F5FA]" aria-labelledby="services-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-10">
        <div class="flex items-center gap-2 mb-3" aria-hidden="true">
          <div class="w-1 h-5 bg-[#0172ae] rounded-full"></div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.15em]">What we do in {suburb.name}</span>
        </div>
        <h2 id="services-heading" class="text-2xl sm:text-3xl font-bold text-[#000000] mb-3">
          Plumbing services available in {suburb.name}
        </h2>
        <p class="text-[#334155] max-w-2xl text-sm leading-relaxed">
          Every service below is available to residential and commercial properties across {suburb.name} {suburb.postcode}.
          All work carried out by QBCC-licensed tradespeople with full insurance.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {SERVICES.map((service) => (
          <a
            href={service.href}
            class="group bg-white border border-slate-200 rounded-xl p-5 hover:border-[#0172ae] hover:shadow-md transition-all"
          >
            <div class="w-10 h-10 rounded-lg bg-[#0172ae]/8 group-hover:bg-[#0172ae]/15 flex items-center justify-center text-xl mb-3 transition-colors" aria-hidden="true">
              {service.icon}
            </div>
            <h3 class="font-semibold text-[#000000] text-sm mb-1.5 group-hover:text-[#0172ae] transition-colors">
              {service.title}
            </h3>
            <p class="text-[#334155] text-xs leading-relaxed">{service.description}</p>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       §4 SERVING [SUBURB] AND NEARBY
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-14 bg-white" aria-labelledby="coverage-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid lg:grid-cols-[1fr_360px] gap-12 items-center">

        <!-- Left: coverage copy -->
        <div>
          <div class="flex items-center gap-2 mb-3" aria-hidden="true">
            <div class="w-1 h-5 bg-[#0172ae] rounded-full"></div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.15em]">Coverage area</span>
          </div>
          <h2 id="coverage-heading" class="text-2xl sm:text-3xl font-bold text-[#000000] mb-4">
            Serving {suburb.name} and nearby suburbs
          </h2>
          <p class="text-[#334155] text-sm leading-relaxed mb-6">
            Our licensed plumbers operate out of the Loganholme area, giving us fast travel times
            to <strong>{suburb.name}</strong> and the surrounding {suburb.postcode} postcode.
            We also regularly attend jobs in the suburbs listed below — no call-out surcharge
            for neighbouring streets or the next suburb over.
          </p>

          <!-- Nearby suburb links -->
          <div class="flex flex-wrap gap-3">
            {nearbyDetails.map((nearby) => (
              <a
                href={`/locations/${nearby.slug}`}
                class="inline-flex items-center gap-1.5 border border-slate-200 hover:border-[#0172ae] text-[#334155] hover:text-[#0172ae] text-sm font-medium px-4 py-2 rounded-full transition-colors"
              >
                <svg class="w-3.5 h-3.5 text-[#0172ae] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Plumber {nearby.name}
              </a>
            ))}
            <a
              href="/service-areas"
              class="inline-flex items-center gap-1.5 bg-[#F0F5FA] border border-slate-200 text-[#334155] hover:text-[#0172ae] text-sm font-medium px-4 py-2 rounded-full transition-colors"
            >
              View all 130+ suburbs →
            </a>
          </div>
        </div>

        <!-- Right: map embed -->
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm aspect-[4/3] lg:aspect-auto lg:h-72">
          <iframe
            title={`Map of ${suburb.name} QLD ${suburb.postcode}`}
            src={`https://maps.google.com/maps?q=${encodeURIComponent(suburb.name + ', QLD ' + suburb.postcode + ', Australia')}&output=embed&z=13`}
            width="100%"
            height="100%"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            aria-label={`Google Maps showing ${suburb.name} QLD`}
          ></iframe>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       §5 FAQ
       ══════════════════════════════════════════════════════════════════════════ -->
  <section class="py-16 bg-[#F0F5FA]" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-10 text-center">
        <div class="flex items-center justify-center gap-2 mb-3" aria-hidden="true">
          <div class="w-1 h-5 bg-[#0172ae] rounded-full"></div>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.15em]">Common questions</span>
          <div class="w-1 h-5 bg-[#0172ae] rounded-full"></div>
        </div>
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-bold text-[#000000]">
          Plumbing questions for {suburb.name}
        </h2>
      </div>

      <div class="space-y-3">
        {FAQS.map((faq, i) => (
          <details
            class="group bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-[#0172ae]/40 transition-colors"
            name="faq-group"
          >
            <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none select-none">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-[10px] font-bold text-[#0172ae] tabular-nums flex-shrink-0">
                  ◆ {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-semibold text-[#000000] text-sm leading-snug">{faq.q}</span>
              </div>
              <!-- Chevron -->
              <svg
                class="w-4 h-4 text-slate-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 pt-1 border-t border-slate-100">
              <p class="text-[#334155] text-sm leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       §6 QUOTE FORM
       ══════════════════════════════════════════════════════════════════════════ -->
  <section id="quote" class="py-16 bg-[#000000]" aria-labelledby="quote-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid lg:grid-cols-[1fr_480px] gap-12 items-start">

        <!-- Left: section copy -->
        <div class="lg:pt-2">
          <div class="flex items-center gap-2 mb-3" aria-hidden="true">
            <div class="w-1 h-5 bg-[#0172ae] rounded-full"></div>
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.15em]">Get started</span>
          </div>
          <h2 id="quote-heading" class="text-2xl sm:text-3xl font-bold text-white mb-4">
            Request a quote for {suburb.name}
          </h2>
          <p class="text-slate-300 text-sm leading-relaxed mb-8">
            Fill in the form and a licensed plumber will call you back within 2 hours during business hours.
            For urgent jobs in <strong class="text-white">{suburb.name}</strong>,
            call us directly on{' '}
            <a href={PHONE_HREF} class="text-[#0172ae] font-bold hover:underline">{PHONE}</a>.
          </p>

          <!-- Guarantees -->
          <div class="space-y-3">
            {[
              { icon: '✓', text: 'Upfront pricing — no hidden fees' },
              { icon: '✓', text: 'Licensed and insured plumbers' },
              { icon: '✓', text: 'Same-day availability in most cases' },
              { icon: '✓', text: 'WorkCover QLD covered' },
            ].map((item) => (
              <div class="flex items-center gap-3 text-slate-300 text-sm">
                <span class="w-5 h-5 rounded-full bg-[#0172ae]/20 border border-[#0172ae]/40 flex items-center justify-center text-[#0172ae] text-xs font-bold flex-shrink-0" aria-hidden="true">
                  {item.icon}
                </span>
                {item.text}
              </div>
            ))}
          </div>
        </div>

        <!-- Right: quote form island -->
        <div>
          <QuoteForm client:load initialService="" />
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
